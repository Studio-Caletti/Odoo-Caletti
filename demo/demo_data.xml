<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="demo_tarea_branding" model="tablero.tarea">
            <field name="name">Branding: Re-diseño de Logotipo</field>
            <field name="user_id" ref="base.user_demo"/>
            <field name="partner_id" ref="base.partner_demo"/>
            <field name="estado">proceso</field>
            <field name="fecha_inicio" eval="obj().env.cr.now()"/>
            <field name="fecha_limite" eval="(datetime.now() + relativedelta(days=10)).strftime('%Y-%m-%d')"/>
            <field name="progreso">30.0</field>
        </record>

        <record id="demo_tarea_web" model="tablero.tarea">
            <field name="name">Web: Ajustes de CSS en Portal</field>
            <field name="user_id" ref="base.user_admin"/>
            <field name="estado">proceso</field>
            <field name="fecha_limite" eval="(datetime.now() + relativedelta(days=1)).strftime('%Y-%m-%d')"/>
            <field name="progreso">85.0</field>
        </record>
    </data>
</odoo>