<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="demo_tarea_branding" model="tablero.tarea">
            <field name="name">Branding: Re-diseño de Logotipo</field>
            <field name="user_id" ref="base.user_demo"/>
            <field name="partner_id" ref="base.partner_demo"/>
            <field name="state">proceso</field>
            <field name="date_started" eval="datetime.now().strftime('%Y-%m-%d %H:%M:%S')"/>
            <field name="date_deadline" eval="(datetime.now() + relativedelta(days=10)).strftime('%Y-%m-%d')"/>
            <field name="progress">30.0</field>
        </record>

        <record id="demo_tarea_web" model="tablero.tarea">
            <field name="name">Web: Ajustes de CSS en Portal</field>
            <field name="user_id" ref="base.user_admin"/>
            <field name="state">proceso</field>
            <field name="date_deadline" eval="(datetime.now() + relativedelta(days=1)).strftime('%Y-%m-%d')"/>
            <field name="progress">85.0</field>
        </record>
    </data>
</odoo>