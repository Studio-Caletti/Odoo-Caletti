<!-- Data del Vertical Creativo: Brief Creativo -->

<odoo>
    <data noupdate="1">

<!-- ================================================
             TEMPLATE 0: PROYECTO CREATIVO REGISTRADO
             Destinatario: cliente (partner_id del proyecto)
             Trigger: create() en creative.project
             Objetivo: confirmar al cliente que su proyecto
             fue registrado y que pronto recibirá el brief.
        ================================================ -->
        <record id="email_template_proyecto_registrado"
                model="mail.template">
            <field name="name">
                Creative: Proyecto Registrado — Confirmación al Cliente
            </field>
            <field name="model_id"
                   ref="tablero_kanban_caletti.model_tablero_tarea"/>
            <field name="subject">
                🎨 Tu proyecto creativo ha sido registrado — {{ object.name }}
            </field>
            <field name="email_from">notifications@caletti.com.mx</field>
            <field name="email_to">
                {{ object.partner_id.email }}
            </field>
            <field name="reply_to">creativos@caletti.com.mx</field>
            <field name="auto_delete" eval="False"/>
            <field name="body_html" type="html">
<div style="margin:0; padding:0; font-family:'Helvetica',sans-serif;
            background-color:#f4f4f4;">
    <table width="100%" style="background-color:#f4f4f4; padding:20px;">
        <tr>
            <td align="center">
                <table width="600"
                       style="background-color:#ffffff;
                              border-radius:8px;
                              margin-top:20px;
                              border-collapse:separate;
                              box-shadow:0 2px 5px rgba(0,0,0,0.1);">
                    <tr>
                        <td style="padding:40px;">
                            <img src="https://caletti.com.mx/odoo17/caletti_odoo.png"
                                 style="height:auto; width:180px;"
                                 alt="Caletti Studio"/>
                            <h2 style="color:#875A7B;
                                       margin-top:20px;
                                       font-size:22px;">
                                🎨 ¡Tu proyecto está en marcha!
                            </h2>
                            <p style="font-size:16px; color:#333;">
                                Hola
                                <strong>
                                    <t t-out="object.partner_id.name or 'Cliente'"/>
                                </strong>,
                            </p>
                            <p style="font-size:15px; color:#555; line-height:1.6;">
                                Hemos registrado tu proyecto creativo
                                en nuestro sistema. Nuestro equipo
                                ya está trabajando en él.
                            </p>
                            <div style="margin:25px 0;
                                        padding:20px;
                                        border-left:4px solid #875A7B;
                                        background-color:#f9f9f9;">
                                <p style="margin:8px 0; font-size:14px;">
                                    <span style="color:#777; font-size:12px;">
                                        Proyecto:
                                    </span><br/>
                                    <strong style="font-size:18px; color:#875A7B;">
                                        <t t-out="object.name"/>
                                    </strong>
                                </p>
                                <p style="margin:8px 0; font-size:14px;">
                                    <span style="color:#777; font-size:12px;">
                                        Responsable:
                                    </span><br/>
                                    <strong>
                                        <t t-out="object.user_id.name or 'Equipo Caletti'"/>
                                    </strong>
                                </p>
                            </div>
                            <p style="font-size:14px; color:#555; line-height:1.6;">
                                En breve recibirás el brief creativo
                                para tu revisión y aprobación.
                                Cualquier duda escríbenos a
                                <a href="mailto:creativos@caletti.com.mx"
                                   style="color:#875A7B;">
                                    creativos@caletti.com.mx
                                </a>
                            </p>
                        </td>
                    </tr>
                    <tr>
                        <td style="padding:20px;
                                   background-color:#f9f9f9;
                                   text-align:center;
                                   border-bottom-left-radius:8px;
                                   border-bottom-right-radius:8px;">
                            <p style="font-size:13px; color:#666; margin:5px 0;">
                                <strong>Equipo Creativo — Caletti Studio</strong>
                            </p>
                            <h5 style="color:#875A7B;">
                                <strong>MÉXICO — BUENOS AIRES — ROMA</strong>
                            </h5>
                            <p style="font-size:11px; color:#aaa; margin:10px 0 0 0;">
                                Notificación automática del sistema creativo
                            </p>
                        </td>
                    </tr>
                </table>
            </td>
        </tr>
    </table>
</div>
            </field>
        </record>

        <!-- ================================================
             ALIAS: creativos@caletti.com.mx
             Crea proyectos creativos desde email entrante.
             Mismo patrón que soporte@caletti.com.mx
             del helpdesk.
        ================================================ -->
        <record id="mail_alias_creative" model="mail.alias">
            <field name="alias_name">creativos</field>
            <field name="alias_model_id" ref="tablero_kanban_caletti.model_tablero_tarea"/>
            <field name="alias_defaults">{'es_proyecto_creativo': True,'state': 'nuevo'}</field>
            <field name="alias_contact">everyone</field>
        </record>


    </data>

</odoo>