<!-- Vista del Vertical Creativo: Entregables Creativos -->

<odoo>

    <!-- ================================================
         ACCIÓN DE VENTANA — ENTREGABLES
         Vista global de todos los entregables del vertical.
         Útil para el director creativo que supervisa
         producción de múltiples proyectos simultáneos.
    ================================================ -->
    <record id="action_creative_deliverable" model="ir.actions.act_window">
        <field name="name">Entregables</field>
        <field name="res_model">creative.deliverable</field>
        <field name="view_mode">kanban,tree,form</field>
        <field name="context">{
            'search_default_activos': 1
        }</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                ¡No hay entregables registrados!
            </p>
            <p>
                Los entregables se crean desde el proyecto creativo.
                Aquí puedes supervisar el avance de todos los proyectos.
            </p>
        </field>
    </record>

    <!-- ================================================
         VISTA FORM — ENTREGABLE CREATIVO
         Form standalone para gestión detallada.
         Botones de workflow según estado actual.
    ================================================ -->
    <record id="view_creative_deliverable_form" model="ir.ui.view">
        <field name="name">creative.deliverable.form</field>
        <field name="model">creative.deliverable</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <!-- WORKFLOW: Pendiente → En Proceso -->
                    <button name="action_iniciar"
                            string="▶️ Iniciar Producción"
                            type="object"
                            class="oe_highlight"
                            invisible="estado != 'pendiente'"/>

                    <!-- WORKFLOW: En Proceso → En Revisión -->
                    <button name="action_enviar_a_revision"
                            string="🔍 Enviar a Revisión"
                            type="object"
                            class="oe_highlight"
                            invisible="estado != 'en_proceso'"/>

                    <!-- WORKFLOW: En Revisión → Aprobado -->
                    <button name="action_aprobar"
                            string="✅ Aprobar"
                            type="object"
                            class="oe_highlight"
                            invisible="estado != 'en_revision'"/>

                    <!-- WORKFLOW: En Revisión → Rechazado (vuelve a En Proceso) -->
                    <button name="action_rechazar"
                            string="❌ Rechazar"
                            type="object"
                            invisible="estado != 'en_revision'"/>

                    <!-- WORKFLOW: Aprobado → Entregado -->
                    <button name="action_marcar_entregado"
                            string="🚀 Marcar como Entregado"
                            type="object"
                            class="oe_highlight"
                            invisible="estado != 'aprobado'"/>

                    <!-- Statusbar visual del lifecycle -->
                    <field name="estado"
                           widget="statusbar"
                           statusbar_visible="pendiente,en_proceso,en_revision,aprobado,entregado"/>
                </header>

                <sheet>

                    <!-- ALERTA: Revisiones excedidas — impacto económico -->
                    <div class="alert alert-danger" role="status"
                         invisible="not revisiones_excedidas">
                        <i class="fa fa-exclamation-triangle me-2" title="Excedido"/>
                        <strong>¡Rondas de revisión excedidas!</strong>
                        Se han utilizado
                        <field name="rondas_utilizadas"
                               readonly="1"
                               nolabel="1"
                               style="display:inline; font-weight:bold;"/>
                        de
                        <field name="max_revisiones"
                               readonly="1"
                               nolabel="1"
                               style="display:inline; font-weight:bold;"/>
                        rondas incluidas.
                        Aplica tarifa adicional.
                        <field name="revisiones_excedidas" invisible="1"/>
                    </div>

                    <!-- ALERTA: Revisiones en alerta — aviso preventivo -->
                    <div class="alert alert-warning" role="status"
                         invisible="not revisiones_en_alerta">
                        <i class="fa fa-clock-o me-2" title="Atencion"/>
                        <strong>Atención:</strong>
                        Ronda
                        <field name="rondas_utilizadas"
                               readonly="1"
                               nolabel="1"
                               style="display:inline;"/>
                        de
                        <field name="max_revisiones"
                               readonly="1"
                               nolabel="1"
                               style="display:inline;"/>
                        incluidas. Próxima revisión genera costo adicional.
                        <field name="revisiones_en_alerta" invisible="1"/>
                    </div>

                    <!-- STAT BUTTONS -->
                    <div class="oe_button_box" name="button_box">
                        <!-- Contador de rondas -->
                        <div class="oe_stat_button"
                             icon="fa-refresh">
                            <div class="o_stat_info">
                                <span class="o_stat_value">
                                    <field name="rondas_utilizadas"
                                           readonly="1"/>
                                    /
                                    <field name="max_revisiones"/>
                                </span>
                                <span class="o_stat_text">Revisiones</span>
                            </div>
                        </div>
                        <!-- Costo adicional — solo visible si hay rondas extra -->
                        <div class="oe_stat_button"
                             icon="fa-usd"
                             invisible="costo_adicional_revisiones == 0">
                            <field name="costo_adicional_revisiones"
                                   string="Costo Extra"
                                   widget="statinfo"/>
                        </div>
                    </div>

                    <!-- TÍTULO -->
                    <div class="oe_title">
                        <label for="name" string="Nombre del Entregable"/>
                        <h1>
                            <field name="name"
                                   placeholder="Ej: Logotipo principal, Banner Facebook 1200x628"/>
                        </h1>
                    </div>

                    <!-- DATOS PRINCIPALES -->
                    <group>
                        <group string="Clasificación">
                            <field name="proyecto_id"/>
                            <field name="cliente_id" readonly="1"/>
                            <field name="tipo_entregable"/>
                            <field name="responsable_id"
                                   widget="many2one_avatar_user"/>
                            <field name="sequence"/>
                        </group>
                        <group string="Fechas">
                            <field name="fecha_inicio"/>
                            <field name="fecha_limite"/>
                            <field name="fecha_entrega_cliente"/>
                            <field name="fecha_aprobacion"
                                   readonly="1"
                                   invisible="not fecha_aprobacion"/>
                            <field name="fecha_entrega_real"
                                   readonly="1"
                                   invisible="not fecha_entrega_real"/>
                        </group>
                    </group>

                    <notebook>

                        <!-- TAB: ESPECIFICACIONES -->
                        <page string="📋 Especificaciones"
                              name="tab_specs">
                              <div class="bg-100 p-3 rounded border">
                                <p>Hola hola</p>
                            
                                <field name="descripcion"
                                       nolabel="1"
                                       placeholder="Dimensiones, formato, resolución, duración, variaciones requeridas, especificaciones técnicas..."
                                       style="min-height: 110px;"/>
                                
                        </div>
                        </page>

                        <!-- TAB: REVISIONES Y COSTOS -->
                        <page string="💰 Revisiones y Costos"
                              name="tab_costos">
                            <group>
                                <group string="Control de Revisiones">
                                    <field name="max_revisiones"/>
                                    <field name="rondas_utilizadas"
                                           readonly="1"/>
                                    <field name="revisiones_excedidas"
                                           readonly="1"
                                           widget="boolean_toggle"/>
                                    <field name="revisiones_en_alerta"
                                           readonly="1"
                                           widget="boolean_toggle"/>
                                </group>
                                <group string="Costos">
                                    <field name="currency_id" invisible="1"/>
                                    <field name="costo_estimado"
                                           widget="monetary"/>
                                    <field name="tarifa_revision_extra"
                                           widget="monetary"/>
                                    <field name="costo_adicional_revisiones"
                                           widget="monetary"
                                           readonly="1"
                                           invisible="costo_adicional_revisiones == 0"/>
                                </group>
                            </group>
                        </page>

                    </notebook>
                </sheet>

                <!-- CHATTER -->
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>

            </form>
        </field>
    </record>

    <!-- ================================================
         VISTA TREE — ENTREGABLES
         Vista global para supervisión de producción.
         Decoraciones semánticas por estado y alertas.
    ================================================ -->
    <record id="view_creative_deliverable_tree" model="ir.ui.view">
    <field name="name">creative.deliverable.tree</field>
    <field name="model">creative.deliverable</field>
    <field name="arch" type="xml">
        <tree sample="1"
              decoration-danger="revisiones_excedidas == True"
              decoration-warning="revisiones_en_alerta == True"
              decoration-success="estado == 'entregado'">
            <field name="sequence" widget="handle"/>
            <field name="name"/>
            <field name="proyecto_id"/>
            <field name="cliente_id"/>
            <field name="tipo_entregable"/>
            <field name="responsable_id"
                   widget="many2one_avatar_user"/>
            <field name="fecha_limite"
                   widget="remaining_days"/>
            <field name="fecha_entrega_cliente"/>
            <field name="estado"
                   widget="badge"/>
            <field name="rondas_utilizadas"/>
            <field name="max_revisiones"/>
            <field name="costo_estimado"
                   widget="monetary"
                   optional="show"/>
            <field name="costo_adicional_revisiones"
                   widget="monetary"
                   optional="show"/>
            <field name="revisiones_excedidas" column_invisible="True"/>
            <field name="revisiones_en_alerta" column_invisible="True"/>
            <field name="currency_id" column_invisible="True"/>
        </tree>
    </field>
</record>

    <!-- ================================================
         VISTA KANBAN — ENTREGABLES
         Columnas por estado de producción.
         Vista principal del equipo creativo día a día.
    ================================================ -->
    <record id="view_creative_deliverable_kanban" model="ir.ui.view">
        <field name="name">creative.deliverable.kanban</field>
        <field name="model">creative.deliverable</field>
        <field name="arch" type="xml">
            <kanban default_group_by="estado"
                    quick_create="false"
                    sample="1">

                <field name="estado"/>
                <field name="tipo_entregable"/>
                <field name="responsable_id"/>
                <field name="fecha_limite"/>
                <field name="fecha_entrega_cliente"/>
                <field name="proyecto_id"/>
                <field name="cliente_id"/>
                <field name="rondas_utilizadas"/>
                <field name="max_revisiones"/>
                <field name="revisiones_excedidas"/>
                <field name="revisiones_en_alerta"/>
                <field name="costo_estimado"/>
                <field name="costo_adicional_revisiones"/>
                <field name="currency_id"/>

                <templates>
                    <t t-name="kanban-box">
                        <div t-attf-class="oe_kanban_global_click shadow-sm
                                           border-rounded mb-2
                                           #{record.revisiones_excedidas.raw_value ?
                                             'border border-danger' :
                                             record.revisiones_en_alerta.raw_value ?
                                             'border border-warning' : ''}">

                            <!-- Ribbon: revisiones excedidas -->
                            <div class="ribbon ribbon-top-right"
                                 t-if="record.revisiones_excedidas.raw_value">
                                <span class="text-bg-danger">EXTRA</span>
                            </div>

                            <div class="oe_kanban_details p-2">

                                <!-- Tipo de entregable badge -->
                                <div class="mb-1">
                                    <span class="badge rounded-pill text-bg-secondary"
                                          style="font-size: 0.65rem;">
                                        <t t-esc="record.tipo_entregable.value or 'Sin tipo'"/>
                                    </span>
                                </div>

                                <!-- Nombre del entregable -->
                                <strong class="o_kanban_record_title">
                                    <field name="name"/>
                                </strong>

                                <!-- Proyecto y cliente -->
                                <div class="text-muted small mt-1">
                                    <i class="fa fa-folder-o me-1" title="Cliente"/>
                                    <field name="proyecto_id"/>
                                </div>
                                <div class="text-muted small"
                                     t-if="record.cliente_id.value">
                                    <i class="fa fa-building-o me-1" title="Cliente"/>
                                    <field name="cliente_id"/>
                                </div>

                                <!-- Control de revisiones -->
                                <div class="mt-2 mb-1">
                                    <t t-set="pct_revisiones"
                                       t-value="(record.rondas_utilizadas.raw_value /
                                                (record.max_revisiones.raw_value or 1)) * 100"/>
                                    <div class="progress"
                                         style="height: 6px; border-radius: 10px;"
                                         title="Rondas de revisión">
                                        <div t-attf-class="progress-bar
                                                #{pct_revisiones >= 100 ? 'bg-danger' :
                                                  pct_revisiones >= 66 ? 'bg-warning' :
                                                  'bg-success'}"
                                             role="progressbar"
                                             t-attf-style="width: #{pct_revisiones}%"/>
                                    </div>
                                    <small class="text-muted">
                                        Revisiones:
                                        <t t-esc="record.rondas_utilizadas.raw_value"/>
                                        /
                                        <t t-esc="record.max_revisiones.raw_value"/>
                                    </small>
                                </div>

                                <!-- Costo adicional si existe -->
                                <div class="mt-1 small text-danger fw-bold"
                                     t-if="record.costo_adicional_revisiones.raw_value > 0">
                                    <i class="fa fa-usd me-1" title="Costos"/>
                                    Costo extra:
                                    <field name="costo_adicional_revisiones"
                                           widget="monetary"/>
                                </div>

                                <!-- Footer: fecha límite y avatar -->
                                <div class="o_kanban_record_bottom mt-2">
                                    <div class="oe_kanban_bottom_left">
                                        <field name="fecha_limite"
                                               widget="remaining_days"/>
                                    </div>
                                    <div class="oe_kanban_bottom_right">
                                        <field name="responsable_id"
                                               widget="many2one_avatar_user"/>
                                    </div>
                                </div>

                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- ================================================
         VISTA SEARCH — ENTREGABLES
    ================================================ -->
    <record id="view_creative_deliverable_search" model="ir.ui.view">
        <field name="name">creative.deliverable.search</field>
        <field name="model">creative.deliverable</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="proyecto_id"/>
                <field name="cliente_id"/>
                <field name="responsable_id"/>
                <field name="tipo_entregable"/>
                <!-- Filtros rápidos -->
                <filter string="Mis Entregables"
                        name="mis_entregables"
                        domain="[('responsable_id', '=', uid)]"/>
                <filter string="⏳ Pendientes"
                        name="pendientes"
                        domain="[('estado', '=', 'pendiente')]"/>
                <filter string="🔄 En Producción"
                        name="activos"
                        domain="[('estado', 'in',
                                  ['en_proceso', 'en_revision'])]"/>
                <filter string="✅ Aprobados"
                        name="aprobados"
                        domain="[('estado', '=', 'aprobado')]"/>
                <filter string="🚀 Entregados"
                        name="entregados"
                        domain="[('estado', '=', 'entregado')]"/>
                <separator/>
                <filter string="⚠️ Revisiones Excedidas"
                        name="revisiones_excedidas"
                        domain="[('revisiones_excedidas', '=', True)]"/>
                <filter string="🔔 Revisiones en Alerta"
                        name="revisiones_alerta"
                        domain="[('revisiones_en_alerta', '=', True)]"/>
                <separator/>
                <group expand="0" string="Agrupar por...">
                    <filter string="Estado"
                            name="group_estado"
                            context="{'group_by': 'estado'}"/>
                    <filter string="Tipo"
                            name="group_tipo"
                            context="{'group_by': 'tipo_entregable'}"/>
                    <filter string="Proyecto"
                            name="group_proyecto"
                            context="{'group_by': 'proyecto_id'}"/>
                    <filter string="Responsable"
                            name="group_responsable"
                            context="{'group_by': 'responsable_id'}"/>
                    <filter string="Cliente"
                            name="group_cliente"
                            context="{'group_by': 'cliente_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- ================================================
         MENÚ — ENTREGABLES dentro del vertical creativo
    ================================================ -->
    <menuitem id="menu_creative_deliverables"
              name="Entregables"
              parent="menu_creative_root"
              action="action_creative_deliverable"
              sequence="30"/>

</odoo>