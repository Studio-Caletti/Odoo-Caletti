<!-- Seguridad: Record Rules del Vertical Inmobiliario -->
<!-- Principio: Asesor ve solo sus propiedades,
                Coordinador ve todo el vertical,
                Admin control total sin restricciones -->

<odoo>
    <data noupdate="0">

        <!-- ================================================
             RECORD RULES: RE.PROPIEDAD
        ================================================ -->

        <!-- Asesor: solo ve y gestiona propiedades
             donde es el asesor_id asignado -->
        <record id="rule_re_propiedad_asesor" model="ir.rule">
            <field name="name">Propiedad: Asesor ve sus propiedades</field>
            <field name="model_id" ref="model_re_propiedad"/>
            <field name="groups"
                   eval="[(4, ref('caletti_real_estate.group_re_asesor'))]"/>
            <field name="domain_force">[
                ('asesor_id', '=', user.id)
            ]</field>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="False"/>
        </record>

        <!-- ================================================
             RECORD RULES: RE.OPERACION (tablero.tarea)
             Las operaciones RE usan el modelo tablero.tarea del Core.
             Estas reglas filtran solo las tareas del vertical RE
             para los grupos del vertical — sin interferir con
             las reglas del Core para group_tablero_user.
        ================================================ -->

        <record id="rule_re_operacion_asesor" model="ir.rule">
            <field name="name">Operación RE: Asesor ve sus operaciones</field>
            <field name="model_id" ref="tablero_kanban_caletti.model_tablero_tarea"/>
            <field name="groups"
                   eval="[(4, ref('caletti_real_estate.group_re_asesor'))]"/>
            <field name="domain_force">[
                ('es_operacion_re', '=', True),
                ('user_id', '=', user.id)
            ]</field>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="False"/>
        </record>

        <record id="rule_re_operacion_coordinador" model="ir.rule">
            <field name="name">Operación RE: Coordinador acceso total</field>
            <field name="model_id" ref="tablero_kanban_caletti.model_tablero_tarea"/>
            <field name="groups"
                   eval="[(4, ref('caletti_real_estate.group_re_coordinador'))]"/>
            <field name="domain_force">[(1, '=', 1)]</field>
        </record>

        <!-- Coordinador: ve y gestiona todas las propiedades del vertical -->
        <record id="rule_re_propiedad_coordinador" model="ir.rule">
            <field name="name">Propiedad: Coordinador acceso total</field>
            <field name="model_id" ref="model_re_propiedad"/>
            <field name="groups"
                   eval="[(4, ref('caletti_real_estate.group_re_coordinador'))]"/>
            <field name="domain_force">[(1, '=', 1)]</field>
        </record>

        <!-- Admin: control total sin restricciones -->
        <record id="rule_re_propiedad_admin" model="ir.rule">
            <field name="name">Propiedad: Admin control total</field>
            <field name="model_id" ref="model_re_propiedad"/>
            <field name="groups"
                   eval="[(4, ref('caletti_real_estate.group_re_admin'))]"/>
            <field name="domain_force">[(1, '=', 1)]</field>
        </record>

        <!-- Portal: propietario ve solo sus propiedades -->
        <record id="rule_re_propiedad_portal" model="ir.rule">
            <field name="name">Propiedad: Portal ve propiedades de su partner</field>
            <field name="model_id" ref="model_re_propiedad"/>
            <field name="groups"
                   eval="[(4, ref('base.group_portal'))]"/>
            <field name="domain_force">[
                ('propietario_id', '=', user.partner_id.id)
            ]</field>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="False"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
        </record>

        <!-- ================================================
             RECORD RULES: RE.PROSPECTO
        ================================================ -->

        <!-- Asesor: solo ve sus propios prospectos -->
        <record id="rule_re_prospecto_asesor" model="ir.rule">
            <field name="name">Prospecto: Asesor ve sus prospectos</field>
            <field name="model_id" ref="model_re_prospecto"/>
            <field name="groups"
                   eval="[(4, ref('caletti_real_estate.group_re_asesor'))]"/>
            <field name="domain_force">[
                ('asesor_id', '=', user.id)
            ]</field>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="False"/>
        </record>

        <!-- Coordinador: ve todos los prospectos del vertical -->
        <record id="rule_re_prospecto_coordinador" model="ir.rule">
            <field name="name">Prospecto: Coordinador acceso total</field>
            <field name="model_id" ref="model_re_prospecto"/>
            <field name="groups"
                   eval="[(4, ref('caletti_real_estate.group_re_coordinador'))]"/>
            <field name="domain_force">[(1, '=', 1)]</field>
        </record>

        <!-- Admin: control total sin restricciones -->
        <record id="rule_re_prospecto_admin" model="ir.rule">
            <field name="name">Prospecto: Admin control total</field>
            <field name="model_id" ref="model_re_prospecto"/>
            <field name="groups"
                   eval="[(4, ref('caletti_real_estate.group_re_admin'))]"/>
            <field name="domain_force">[(1, '=', 1)]</field>
        </record>

        <!-- ================================================
             RECORD RULES: RE.CONTRATO
        ================================================ -->

        <record id="rule_re_contrato_asesor" model="ir.rule">
            <field name="name">Contrato: Asesor ve sus contratos</field>
            <field name="model_id" ref="model_re_contrato"/>
            <field name="groups"
                   eval="[(4, ref('caletti_real_estate.group_re_asesor'))]"/>
            <field name="domain_force">[('asesor_id', '=', user.id)]</field>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="False"/>
        </record>

        <record id="rule_re_contrato_coordinador" model="ir.rule">
            <field name="name">Contrato: Coordinador acceso total</field>
            <field name="model_id" ref="model_re_contrato"/>
            <field name="groups"
                   eval="[(4, ref('caletti_real_estate.group_re_coordinador'))]"/>
            <field name="domain_force">[(1, '=', 1)]</field>
        </record>

        <record id="rule_re_contrato_admin" model="ir.rule">
            <field name="name">Contrato: Admin control total</field>
            <field name="model_id" ref="model_re_contrato"/>
            <field name="groups"
                   eval="[(4, ref('caletti_real_estate.group_re_admin'))]"/>
            <field name="domain_force">[(1, '=', 1)]</field>
        </record>

        <!-- ================================================
             RECORD RULES: RE.PAGO
        ================================================ -->

        <record id="rule_re_pago_asesor" model="ir.rule">
            <field name="name">Pago: Asesor ve pagos de sus contratos</field>
            <field name="model_id" ref="model_re_pago"/>
            <field name="groups"
                   eval="[(4, ref('caletti_real_estate.group_re_asesor'))]"/>
            <field name="domain_force">[
                ('contrato_id.asesor_id', '=', user.id)
            ]</field>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="False"/>
        </record>

        <record id="rule_re_pago_coordinador" model="ir.rule">
            <field name="name">Pago: Coordinador acceso total</field>
            <field name="model_id" ref="model_re_pago"/>
            <field name="groups"
                   eval="[(4, ref('caletti_real_estate.group_re_coordinador'))]"/>
            <field name="domain_force">[(1, '=', 1)]</field>
        </record>

        <record id="rule_re_pago_admin" model="ir.rule">
            <field name="name">Pago: Admin control total</field>
            <field name="model_id" ref="model_re_pago"/>
            <field name="groups"
                   eval="[(4, ref('caletti_real_estate.group_re_admin'))]"/>
            <field name="domain_force">[(1, '=', 1)]</field>
        </record>

        <!-- ================================================
             RECORD RULES: RE.MANTENIMIENTO
        ================================================ -->

        <record id="rule_re_mantenimiento_asesor" model="ir.rule">
            <field name="name">Mantenimiento: Asesor ve sus registros</field>
            <field name="model_id" ref="model_re_mantenimiento"/>
            <field name="groups"
                   eval="[(4, ref('caletti_real_estate.group_re_asesor'))]"/>
            <field name="domain_force">[
                ('asesor_id', '=', user.id)
            ]</field>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="False"/>
        </record>

        <record id="rule_re_mantenimiento_coordinador" model="ir.rule">
            <field name="name">Mantenimiento: Coordinador acceso total</field>
            <field name="model_id" ref="model_re_mantenimiento"/>
            <field name="groups"
                   eval="[(4, ref('caletti_real_estate.group_re_coordinador'))]"/>
            <field name="domain_force">[(1, '=', 1)]</field>
        </record>

        <record id="rule_re_mantenimiento_admin" model="ir.rule">
            <field name="name">Mantenimiento: Admin control total</field>
            <field name="model_id" ref="model_re_mantenimiento"/>
            <field name="groups"
                   eval="[(4, ref('caletti_real_estate.group_re_admin'))]"/>
            <field name="domain_force">[(1, '=', 1)]</field>
        </record>

        <!-- Portal: inquilino ve solo mantenimientos de su propiedad -->
        <record id="rule_re_mantenimiento_portal" model="ir.rule">
            <field name="name">Mantenimiento: Portal ve tickets de su propiedad</field>
            <field name="model_id" ref="model_re_mantenimiento"/>
            <field name="groups"
                   eval="[(4, ref('base.group_portal'))]"/>
            <field name="domain_force">[
                ('propiedad_id.propietario_id', '=', user.partner_id.id)
            ]</field>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="False"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
        </record>

        <!-- ================================================
             RECORD RULES PORTAL: RE.CONTRATO
             Propietario ve contratos de sus propiedades.
             Inquilino ve contratos donde es inquilino_id.
             Ambas reglas son OR — Odoo aplica la más permisiva
             cuando el usuario cumple más de una condición.
        ================================================ -->

        <record id="rule_re_contrato_portal_propietario" model="ir.rule">
            <field name="name">Contrato: Portal propietario ve sus contratos</field>
            <field name="model_id" ref="model_re_contrato"/>
            <field name="groups"
                   eval="[(4, ref('base.group_portal'))]"/>
            <field name="domain_force">[
                '|',
                ('propiedad_id.propietario_id', '=', user.partner_id.id),
                ('inquilino_id',                '=', user.partner_id.id)
            ]</field>
            <field name="perm_read"   eval="True"/>
            <field name="perm_write"  eval="False"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
        </record>

        <!-- ================================================
             RECORD RULES PORTAL: RE.PAGO
             Propietario ve pagos de sus propiedades.
             Inquilino ve pagos donde es inquilino_id.
        ================================================ -->

        <record id="rule_re_pago_portal" model="ir.rule">
            <field name="name">Pago: Portal ve pagos según rol</field>
            <field name="model_id" ref="model_re_pago"/>
            <field name="groups"
                   eval="[(4, ref('base.group_portal'))]"/>
            <field name="domain_force">[
                '|',
                ('propiedad_id.propietario_id', '=', user.partner_id.id),
                ('inquilino_id',                '=', user.partner_id.id)
            ]</field>
            <field name="perm_read"   eval="True"/>
            <field name="perm_write"  eval="False"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
        </record>

        <!-- ================================================
             RECORD RULES PORTAL: RE.MANTENIMIENTO
             Reemplaza la regla existente solo-propietario.
             Inquilino también debe ver sus tickets creados.
             La regla existente rule_re_mantenimiento_portal
             ya existe — este record actualiza su domain_force
             para incluir al inquilino.
        ================================================ -->

        <record id="rule_re_mantenimiento_portal_inquilino" model="ir.rule">
            <field name="name">Mantenimiento: Portal inquilino ve sus tickets</field>
            <field name="model_id" ref="model_re_mantenimiento"/>
            <field name="groups"
                   eval="[(4, ref('base.group_portal'))]"/>
            <field name="domain_force">[
                '|',
                ('propiedad_id.propietario_id', '=', user.partner_id.id),
                ('inquilino_id',                '=', user.partner_id.id)
            ]</field>
            <field name="perm_read"   eval="True"/>
            <field name="perm_write"  eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="False"/>
        </record>

        <!-- ================================================
             RECORD RULES: RE.VISITA
        ================================================ -->

        <record id="rule_re_visita_asesor" model="ir.rule">
            <field name="name">Visita: Asesor ve sus visitas</field>
            <field name="model_id" ref="model_re_visita"/>
            <field name="groups"
                   eval="[(4, ref('caletti_real_estate.group_re_asesor'))]"/>
            <field name="domain_force">[
                ('asesor_id', '=', user.id)
            ]</field>
            <field name="perm_read"   eval="True"/>
            <field name="perm_write"  eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="False"/>
        </record>

        <record id="rule_re_visita_coordinador" model="ir.rule">
            <field name="name">Visita: Coordinador acceso total</field>
            <field name="model_id" ref="model_re_visita"/>
            <field name="groups"
                   eval="[(4, ref('caletti_real_estate.group_re_coordinador'))]"/>
            <field name="domain_force">[(1, '=', 1)]</field>
        </record>

        <record id="rule_re_visita_admin" model="ir.rule">
            <field name="name">Visita: Admin control total</field>
            <field name="model_id" ref="model_re_visita"/>
            <field name="groups"
                   eval="[(4, ref('caletti_real_estate.group_re_admin'))]"/>
            <field name="domain_force">[(1, '=', 1)]</field>
        </record>
        

    </data>
</odoo>
