<!-- Vista del Vertical Inmobiliario: Operaciones -->
<!-- Hereda tablero.tarea — vista propia del vertical con domain -->

<odoo>

    <!-- ================================================
         ACCIÓN DE VENTANA — OPERACIONES ACTIVAS
         Domain: es_operacion_re = True AND etapa != cerrada
         Context: fuerza es_operacion_re=True al crear
    ================================================ -->
    <record id="action_re_operacion" model="ir.actions.act_window">
        <field name="name">Operaciones</field>
        <field name="res_model">tablero.tarea</field>
        <field name="view_mode">kanban,tree,form</field>
        <field name="domain">[
            ('es_operacion_re', '=', True),
            ('etapa_re', '!=', 'cerrada')
        ]</field>
        <field name="context">{
            'default_es_operacion_re': True,
            'search_default_mis_operaciones': 1
        }</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                ¡Crea tu primera operación inmobiliaria!
            </p>
            <p>
                Cada operación representa la gestión activa de
                una propiedad — desde la captación hasta el cierre
                del contrato de renta o venta.
            </p>
        </field>
    </record>

    <!-- ================================================
         ACCIÓN HISTORIAL — OPERACIONES CERRADAS
         Accesible desde el menú secundario
    ================================================ -->
    <record id="action_re_operacion_historial"
            model="ir.actions.act_window">
        <field name="name">Historial de Operaciones</field>
        <field name="res_model">tablero.tarea</field>
        <field name="view_mode">tree,form</field>
        <field name="domain">[
            ('es_operacion_re', '=', True),
            ('etapa_re', '=', 'cerrada')
        ]</field>
        <field name="context">{'default_es_operacion_re': True}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Aún no hay operaciones cerradas.
            </p>
            <p>
                Aquí aparecerán las operaciones finalizadas
                como historial completo por propiedad.
            </p>
        </field>
    </record>

    <!-- ================================================
         VISTA KANBAN — OPERACIONES INMOBILIARIAS
         Vista principal del vertical.
         Agrupada por etapa_re — pipeline visual del asesor.
         Hereda tablero.tarea pero con vista propia del vertical.
    ================================================ -->
    <record id="view_re_operacion_kanban" model="ir.ui.view">
        <field name="name">re.operacion.kanban</field>
        <field name="model">tablero.tarea</field>
        <field name="arch" type="xml">
            <kanban default_group_by="etapa_re"
                    quick_create="false"
                    class="o_kanban_small_column"
                    sample="1">

                <field name="name"/>
                <field name="es_operacion_re"/>
                <field name="etapa_re"/>
                <field name="tipo_operacion_re"/>
                <field name="propiedad_id"/>
                <field name="propietario_id"/>
                <field name="tipo_propiedad_re"/>
                <field name="estado_propiedad"/>
                <field name="prospecto_activo_id"/>
                <field name="contrato_id"/>
                <field name="precio_objetivo"/>
                <field name="dias_en_operacion"/>
                <field name="currency_id"/>
                <field name="user_id"/>
                <field name="priority"/>
                <field name="date_deadline"/>
                <field name="is_overdue"/>
                <field name="color"/>

                <templates>
                    <t t-name="kanban-box">
                        <div t-attf-class="oe_kanban_color_#{kanban_getcolor(record.color.raw_value)}
                                           oe_kanban_global_click shadow-sm border-rounded mb-2"
                             t-attf-style="#{record.is_overdue.raw_value ?
                                'border-left: 6px solid #d9534f !important;' : ''}">

                            <!-- Ribbon: vencida (hereda lógica del Core) -->
                            <div class="ribbon ribbon-top-right"
                                 t-if="record.is_overdue.raw_value">
                                <span class="text-bg-danger">VENCIDA</span>
                            </div>

                            <div class="oe_kanban_details p-2">

                                <!-- Tipo de operación + tipo de propiedad -->
                                <div class="d-flex gap-1 mb-1 flex-wrap">
                                    <span t-if="record.tipo_operacion_re.raw_value == 'renta'"
                                          class="badge rounded-pill text-bg-info text-dark"
                                          style="font-size: 0.62rem;">
                                        🔑 RENTA
                                    </span>
                                    <span t-if="record.tipo_operacion_re.raw_value == 'venta'"
                                          class="badge rounded-pill text-bg-warning text-dark"
                                          style="font-size: 0.62rem;">
                                        💰 VENTA
                                    </span>
                                    <span class="badge rounded-pill text-bg-secondary"
                                          style="font-size: 0.62rem;"
                                          t-if="record.tipo_propiedad_re.value">
                                        <t t-esc="record.tipo_propiedad_re.value"/>
                                    </span>
                                </div>

                                <!-- Nombre de la operación -->
                                <strong class="o_kanban_record_title"
                                        style="font-size: 0.82rem;">
                                    <field name="name"/>
                                </strong>

                                <!-- Propiedad -->
                                <div class="mt-1 small">
                                    <i class="fa fa-home me-1" title="Propiedad"/>
                                    <field name="propiedad_id"/>
                                </div>

                                <!-- Propietario -->
                                <div class="text-muted small"
                                     t-if="record.propietario_id.value">
                                    <i class="fa fa-user-o me-1" title="Propietario"/>
                                    <field name="propietario_id"/>
                                </div>

                                <!-- Prospecto activo -->
                                <div class="mt-1 small text-primary"
                                     t-if="record.prospecto_activo_id.value">
                                    <i class="fa fa-user-circle me-1" title="Prospecto"/>
                                    <field name="prospecto_activo_id"/>
                                </div>

                                <!-- Precio objetivo -->
                                <div class="mt-1 small fw-bold"
                                     t-if="record.precio_objetivo.raw_value > 0">
                                    <i class="fa fa-usd me-1" title="Precio"/>
                                    <field name="precio_objetivo"
                                           widget="monetary"/>
                                </div>

                                <!-- Contrato vinculado -->
                                <div class="mt-1 small text-success"
                                     t-if="record.contrato_id.value">
                                    <i class="fa fa-file-text-o me-1" title="Contrato"/>
                                    <field name="contrato_id"/>
                                </div>

                                <!-- Días en operación -->
                                <div class="mt-1 small text-muted"
                                     t-if="record.dias_en_operacion.raw_value > 0">
                                    <i class="fa fa-clock-o me-1" title="Días"/>
                                    <t t-esc="record.dias_en_operacion.raw_value"/>
                                    días
                                </div>

                                <!-- Footer: prioridad, deadline, asesor -->
                                <div class="o_kanban_record_bottom mt-2">
                                    <div class="oe_kanban_bottom_left">
                                        <field name="priority"
                                               widget="priority"/>
                                        <field name="date_deadline"
                                               widget="remaining_days"/>
                                    </div>
                                    <div class="oe_kanban_bottom_right">
                                        <field name="user_id"
                                               widget="many2one_avatar_user"/>
                                    </div>
                                </div>

                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- ================================================
         VISTA FORM — OPERACIÓN INMOBILIARIA
         Hereda tablero.tarea via xpath.
         Inyecta los campos del vertical antes del notebook del Core.
    ================================================ -->
    <record id="view_re_operacion_form" model="ir.ui.view">
        <field name="name">re.operacion.form</field>
        <field name="model">tablero.tarea</field>
        <field name="inherit_id"
               ref="tablero_kanban_caletti.view_tablero_tarea_form"/>
        <field name="arch" type="xml">

            <!-- Campo discriminador — invisible -->
            <xpath expr="//sheet" position="inside">
                <field name="es_operacion_re" invisible="1"/>
                <field name="etapa_re" invisible="1"/>
            </xpath>

            <!-- Inyectar bloque RE debajo del título del Core -->
            <xpath expr="//div[hasclass('oe_title')]" position="after">
                <div invisible="not es_operacion_re">

                    <!-- Alerta: operación en negociación -->
                    <div class="alert alert-info" role="status"
                         invisible="etapa_re != 'negociacion'">
                        <i class="fa fa-handshake-o me-2" title="Negociación"/>
                        <strong>Operación en Negociación.</strong>
                        Gestiona la oferta y condiciones con las partes.
                        Vincula el contrato al avanzar a Cierre.
                    </div>

                    <!-- Pipeline del vertical -->
                    <group string="Operación Inmobiliaria">
                        <group>
                            <field name="propiedad_id"
                                   options="{'no_create': True}"
                                   domain="[('asesor_id', '=', uid)]"/>
                            <field name="tipo_operacion_re"/>
                            <field name="precio_objetivo"
                                   widget="monetary"/>
                        </group>
                        <group>
                            <field name="etapa_re"
                                   widget="statusbar"
                                   statusbar_visible="captacion,difusion,con_prospecto,negociacion,cierre"/>
                            <field name="prospecto_activo_id"
                                   domain="[('asesor_id', '=', uid),
                                            ('etapa', 'not in', ['cerrado','descartado'])]"
                                   options="{'no_create': True}"
                                   invisible="etapa_re not in ['con_prospecto','negociacion','documentacion','cierre']"/>
                            <field name="contrato_id"
                                   domain="[('propiedad_id', '=', propiedad_id)]"
                                   options="{'no_create': True}"
                                   invisible="etapa_re not in ['documentacion','cierre','cerrada']"
                                   readonly="1"/>
                        </group>
                    </group>

                    <!-- Datos de la propiedad (solo lectura — referencia rápida) -->
                    <group string="Datos de la Propiedad"
                           invisible="not propiedad_id">
                        <field name="propietario_id" readonly="1"/>
                        <field name="tipo_propiedad_re" readonly="1"/>
                        <field name="estado_propiedad" readonly="1"/>
                        <field name="dias_en_operacion" readonly="1"/>
                    </group>

                    <!-- Botones de workflow del pipeline RE -->
                    <div class="mt-2 mb-2"
                         invisible="etapa_re == 'cerrada'">
                        <button name="action_avanzar_etapa_re"
                                string="Avanzar Etapa ▶"
                                type="object"
                                class="btn btn-primary btn-sm me-2"
                                invisible="etapa_re in ['cierre','cerrada']"/>
                        <button name="action_cerrar_operacion"
                                string="📦 Cerrar y Archivar"
                                type="object"
                                class="btn btn-secondary btn-sm"
                                invisible="etapa_re != 'cierre'"/>
                    </div>

                </div>
            </xpath>

        </field>
    </record>

    <!-- ================================================
         VISTA TREE — OPERACIONES
    ================================================ -->
    <record id="view_re_operacion_tree" model="ir.ui.view">
        <field name="name">re.operacion.tree</field>
        <field name="model">tablero.tarea</field>
        <field name="arch" type="xml">
            <tree sample="1"
                  decoration-danger="is_overdue == True"
                  decoration-success="etapa_re == 'cierre'"
                  decoration-secondary="etapa_re == 'cerrada'">
                <field name="name"/>
                <field name="tipo_operacion_re"
                       widget="badge"
                       decoration-info="tipo_operacion_re == 'renta'"
                       decoration-warning="tipo_operacion_re == 'venta'"/>
                <field name="propiedad_id"/>
                <field name="tipo_propiedad_re"/>
                <field name="propietario_id"/>
                <field name="prospecto_activo_id" optional="show"/>
                <field name="precio_objetivo"
                       widget="monetary"
                       optional="show"/>
                <field name="dias_en_operacion"/>
                <field name="date_deadline"
                       widget="remaining_days"
                       optional="show"/>
                <field name="user_id"
                       widget="many2one_avatar_user"/>
                <field name="etapa_re"
                       widget="badge"
                       decoration-info="etapa_re in ['captacion','difusion']"
                       decoration-warning="etapa_re in ['con_prospecto','negociacion']"
                       decoration-primary="etapa_re == 'documentacion'"
                       decoration-success="etapa_re == 'cierre'"
                       decoration-secondary="etapa_re == 'cerrada'"/>
                <field name="is_overdue" column_invisible="True"/>
                <field name="es_operacion_re" column_invisible="True"/>
                <field name="currency_id" column_invisible="True"/>
            </tree>
        </field>
    </record>

    <!-- ================================================
         VISTA SEARCH — OPERACIONES
    ================================================ -->
    <record id="view_re_operacion_search" model="ir.ui.view">
        <field name="name">re.operacion.search</field>
        <field name="model">tablero.tarea</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="propiedad_id"/>
                <field name="propietario_id"/>
                <field name="user_id"/>
                <field name="prospecto_activo_id"/>
                <!-- Filtros de etapa -->
                <filter string="📋 Captación"
                        name="captacion"
                        domain="[('etapa_re', '=', 'captacion')]"/>
                <filter string="📢 Difusión"
                        name="difusion"
                        domain="[('etapa_re', '=', 'difusion')]"/>
                <filter string="👤 Con Prospecto"
                        name="con_prospecto"
                        domain="[('etapa_re', '=', 'con_prospecto')]"/>
                <filter string="🤝 Negociación"
                        name="negociacion"
                        domain="[('etapa_re', '=', 'negociacion')]"/>
                <filter string="✅ Cierre"
                        name="cierre"
                        domain="[('etapa_re', '=', 'cierre')]"/>
                <separator/>
                <!-- Filtros de tipo -->
                <filter string="🔑 Renta"
                        name="renta"
                        domain="[('tipo_operacion_re', '=', 'renta')]"/>
                <filter string="💰 Venta"
                        name="venta"
                        domain="[('tipo_operacion_re', '=', 'venta')]"/>
                <separator/>
                <!-- Alerta vencidas — hereda del Core -->
                <filter string="⚠️ Vencidas"
                        name="vencidas"
                        domain="[('is_overdue', '=', True),
                                 ('etapa_re', '!=', 'cerrada')]"/>
                <separator/>
                <filter string="Mis Operaciones"
                        name="mis_operaciones"
                        domain="[('user_id', '=', uid)]"/>
                <separator/>
                <group expand="0" string="Agrupar por...">
                    <filter string="Etapa"
                            name="group_etapa"
                            context="{'group_by': 'etapa_re'}"/>
                    <filter string="Tipo de Operación"
                            name="group_tipo"
                            context="{'group_by': 'tipo_operacion_re'}"/>
                    <filter string="Propiedad"
                            name="group_propiedad"
                            context="{'group_by': 'propiedad_id'}"/>
                    <filter string="Asesor"
                            name="group_asesor"
                            context="{'group_by': 'user_id'}"/>
                    <filter string="Tipo de Propiedad"
                            name="group_tipo_prop"
                            context="{'group_by': 'tipo_propiedad_re'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- ================================================
         MENÚS — OPERACIONES E HISTORIAL
         Operaciones activas: menú principal del vertical
         Historial: submenú secundario
    ================================================ -->
    <menuitem id="menu_re_operaciones"
              name="Operaciones"
              parent="menu_re_root"
              action="action_re_operacion"
              sequence="5"/>

    <menuitem id="menu_re_operaciones_historial"
              name="Historial"
              parent="menu_re_root"
              action="action_re_operacion_historial"
              sequence="55"/>

</odoo>
