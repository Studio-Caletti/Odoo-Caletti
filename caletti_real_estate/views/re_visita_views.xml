<!-- Vistas del modelo re.visita — Vertical Inmobiliario -->

<odoo>

    <!-- ================================================
         VISTA FORM — VISITA
    ================================================ -->
    <record id="view_re_visita_form" model="ir.ui.view">
        <field name="name">re.visita.form</field>
        <field name="model">re.visita</field>
        <field name="arch" type="xml">
            <form string="Visita a Propiedad">
                <header>
                    <button name="action_marcar_realizada"
                            string="✅ Marcar Realizada"
                            type="object"
                            class="btn-primary"
                            invisible="estado != 'agendada'"/>
                    <button name="action_marcar_no_show"
                            string="👻 No Show"
                            type="object"
                            class="btn-warning"
                            invisible="estado != 'agendada'"/>
                    <button name="action_marcar_cancelada"
                            string="❌ Cancelar Visita"
                            type="object"
                            class="btn-secondary"
                            invisible="estado != 'agendada'"/>
                    <button name="action_vincular_contrato"
                            string="🔗 Vincular Contrato"
                            type="object"
                            class="btn-secondary"
                            invisible="estado != 'realizada' or convirtio"/>
                    <field name="estado"
                           widget="statusbar"
                           statusbar_visible="agendada,realizada"/>
                </header>

                <sheet>
                    <!-- Alerta feedback pendiente -->
                    <div class="alert alert-warning"
                         role="alert"
                         invisible="estado != 'realizada' or interes_prospecto">
                        <i class="fa fa-exclamation-triangle me-2" title="Warning"/>
                        <strong>Feedback pendiente.</strong>
                        Registra el nivel de interés y próxima acción
                        para mantener el pipeline actualizado.
                    </div>

                    <!-- Alerta conversión -->
                    <div class="alert alert-success"
                         role="alert"
                         invisible="not convirtio">
                        <i class="fa fa-trophy me-2" title="Conversión"/>
                        <strong>¡Visita convertida!</strong>
                        Esta visita resultó en el contrato
                        <field name="contrato_id"
                               readonly="1"
                               nolabel="1"
                               class="fw-bold"/>
                    </div>

                    <div class="oe_title">
                        <h1>
                            <field name="name" readonly="1"/>
                        </h1>
                    </div>

                    <!-- ============================================
                         SECCIÓN: AGENDA Y VINCULACIÓN
                    ============================================ -->
                    <group string="Agenda">
                        <group>
                            <field name="fecha_visita"/>
                            <field name="duracion_min"
                                   widget="integer"/>
                            <field name="asesor_id"/>
                        </group>
                        <group>
                            <field name="prospecto_id"
                                   options="{'no_create': True}"/>
                            <field name="propiedad_id"
                                   options="{'no_create': True}"
                                   domain="[('estado', 'in', ['disponible', 'en_negociacion'])]"/>
                            <field name="es_primera_visita"
                                   readonly="1"/>
                        </group>
                    </group>

                    <!-- ============================================
                         SECCIÓN: FEEDBACK
                         Solo visible cuando la visita fue realizada
                    ============================================ -->
                    <group string="Feedback del Asesor"
                           invisible="estado not in ['realizada', 'no_show']">
                        <group>
                            <field name="interes_prospecto"/>
                            <field name="probabilidad_cierre"
                                   widget="percentage"/>
                            <field name="proxima_accion"/>
                        </group>
                        <group>
                            <field name="convirtio"
                                   readonly="1"/>
                            <field name="dias_hasta_cierre"
                                   readonly="1"
                                   invisible="not convirtio"/>
                        </group>
                    </group>

                    <group invisible="estado not in ['realizada', 'no_show']">
                        <field name="objeciones"
                               placeholder="Objeciones, dudas o condiciones planteadas por el prospecto..."/>
                        <field name="notas_asesor"
                               placeholder="Observaciones del asesor, condiciones de la propiedad, próximos pasos..."/>
                    </group>

                    <field name="currency_id" invisible="1"/>

                </sheet>

                <!-- Chatter -->
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <!-- ================================================
         VISTA TREE — VISITAS
    ================================================ -->
    <record id="view_re_visita_tree" model="ir.ui.view">
        <field name="name">re.visita.tree</field>
        <field name="model">re.visita</field>
        <field name="arch" type="xml">
            <tree string="Visitas"
                  decoration-success="estado == 'realizada' and convirtio"
                  decoration-info="estado == 'realizada' and not convirtio"
                  decoration-warning="estado == 'no_show'"
                  decoration-muted="estado == 'cancelada'"
                  decoration-danger="estado == 'agendada' and fecha_visita &lt; current_datetime">

                <field name="convirtio" column_invisible="True"/>
                <field name="current_datetime" column_invisible="True"
                       optional="hide"/>

                <field name="name" string="Referencia"/>
                <field name="fecha_visita"/>
                <field name="prospecto_id"/>
                <field name="propiedad_id"/>
                <field name="asesor_id"
                       widget="many2one_avatar_user"/>
                <field name="es_primera_visita"
                       widget="boolean_toggle"
                       readonly="1"
                       optional="show"/>
                <field name="interes_prospecto"
                       widget="badge"
                       decoration-success="interes_prospecto in ['muy_alto', 'alto']"
                       decoration-warning="interes_prospecto == 'medio'"
                       decoration-danger="interes_prospecto in ['bajo', 'sin_interes']"
                       optional="show"/>
                <field name="probabilidad_cierre"
                       widget="percentage"
                       optional="show"/>
                <field name="proxima_accion"
                       optional="hide"/>
                <field name="dias_hasta_cierre"
                       optional="show"/>
                <field name="estado"
                       widget="badge"
                       decoration-info="estado == 'agendada'"
                       decoration-success="estado == 'realizada'"
                       decoration-danger="estado == 'cancelada'"
                       decoration-warning="estado == 'no_show'"/>
            </tree>
        </field>
    </record>

    <!-- ================================================
         VISTA KANBAN — VISITAS
         Agrupado por estado por defecto
    ================================================ -->
    <record id="view_re_visita_kanban" model="ir.ui.view">
        <field name="name">re.visita.kanban</field>
        <field name="model">re.visita</field>
        <field name="arch" type="xml">
            <kanban default_group_by="estado"
                    quick_create="false"
                    class="o_kanban_small_column"
                    sample="1">

                <field name="name"/>
                <field name="estado"/>
                <field name="fecha_visita"/>
                <field name="prospecto_id"/>
                <field name="propiedad_id"/>
                <field name="asesor_id"/>
                <field name="interes_prospecto"/>
                <field name="probabilidad_cierre"/>
                <field name="convirtio"/>
                <field name="es_primera_visita"/>
                <field name="color"/>

                <templates>
                    <t t-name="kanban-box">
                        <div t-attf-class="oe_kanban_color_#{kanban_getcolor(record.color.raw_value)}
                                           oe_kanban_global_click shadow-sm border-rounded mb-2">
                            <div class="oe_kanban_details p-2">

                                <!-- Badges superiores -->
                                <div class="d-flex gap-1 mb-1 flex-wrap">
                                    <span t-if="record.es_primera_visita.raw_value"
                                          class="badge rounded-pill text-bg-info"
                                          style="font-size:0.6rem;">
                                        1ª Visita
                                    </span>
                                    <span t-if="record.convirtio.raw_value"
                                          class="badge rounded-pill text-bg-success"
                                          style="font-size:0.6rem;">
                                        🏆 Convertida
                                    </span>
                                </div>

                                <!-- Nombre -->
                                <strong class="o_kanban_record_title"
                                        style="font-size:0.8rem;">
                                    <field name="name"/>
                                </strong>

                                <!-- Propiedad -->
                                <div class="mt-1 small">
                                    <i class="fa fa-home me-1" title="Propiedad"/>
                                    <field name="propiedad_id"/>
                                </div>

                                <!-- Prospecto -->
                                <div class="small text-muted">
                                    <i class="fa fa-user me-1" title="Prospecto"/>
                                    <field name="prospecto_id"/>
                                </div>

                                <!-- Fecha -->
                                <div class="mt-1 small text-primary">
                                    <i class="fa fa-calendar me-1" title="Fecha"/>
                                    <field name="fecha_visita"
                                           widget="datetime"/>
                                </div>

                                <!-- Interés si está realizada -->
                                <div t-if="record.interes_prospecto.raw_value"
                                     class="mt-1 small">
                                    <t t-esc="record.interes_prospecto.value"/>
                                </div>

                                <!-- Probabilidad -->
                                <div t-if="record.probabilidad_cierre.raw_value > 0"
                                     class="mt-1 small fw-bold">
                                    <i class="fa fa-percent me-1" title="Prob. Cierre"/>
                                    <t t-esc="record.probabilidad_cierre.raw_value"/>%
                                </div>

                                <!-- Footer -->
                                <div class="o_kanban_record_bottom mt-2">
                                    <div class="oe_kanban_bottom_left"/>
                                    <div class="oe_kanban_bottom_right">
                                        <field name="asesor_id"
                                               widget="many2one_avatar_user"/>
                                    </div>
                                </div>

                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- ================================================
         VISTA CALENDAR — AGENDA DEL ASESOR
    ================================================ -->
    <record id="view_re_visita_calendar" model="ir.ui.view">
        <field name="name">re.visita.calendar</field>
        <field name="model">re.visita</field>
        <field name="arch" type="xml">
            <calendar string="Agenda de Visitas"
                      date_start="fecha_visita"
                      color="estado"
                      mode="month"
                      quick_create="false">
                <field name="propiedad_id"/>
                <field name="prospecto_id"/>
                <field name="asesor_id"
                       filters="1"
                       invisible="1"/>
                <field name="estado"/>
            </calendar>
        </field>
    </record>

    <!-- ================================================
         VISTA SEARCH — VISITAS
    ================================================ -->
    <record id="view_re_visita_search" model="ir.ui.view">
        <field name="name">re.visita.search</field>
        <field name="model">re.visita</field>
        <field name="arch" type="xml">
            <search string="Buscar Visitas">
                <field name="name"/>
                <field name="prospecto_id"/>
                <field name="propiedad_id"/>
                <field name="asesor_id"/>

                <!-- Filtros por estado -->
                <filter string="📅 Agendadas"
                        name="agendadas"
                        domain="[('estado', '=', 'agendada')]"/>
                <filter string="✅ Realizadas"
                        name="realizadas"
                        domain="[('estado', '=', 'realizada')]"/>
                <filter string="👻 No Show"
                        name="no_show"
                        domain="[('estado', '=', 'no_show')]"/>
                <filter string="❌ Canceladas"
                        name="canceladas"
                        domain="[('estado', '=', 'cancelada')]"/>
                <separator/>

                <!-- Filtros de métricas -->
                <filter string="🏆 Convertidas"
                        name="convertidas"
                        domain="[('convirtio', '=', True)]"/>
                <filter string="1ª Visita"
                        name="primera_visita"
                        domain="[('es_primera_visita', '=', True)]"/>
                <filter string="🔥 Interés Muy Alto"
                        name="interes_muy_alto"
                        domain="[('interes_prospecto', 'in', ['muy_alto', 'alto'])]"/>
                <separator/>

                <!-- Filtros de tiempo -->
                <filter string="Hoy"
                        name="hoy"
                        domain="[('fecha_visita', '>=', datetime.datetime.combine(context_today(), datetime.time(0,0,0))),
                                  ('fecha_visita', '&lt;=', datetime.datetime.combine(context_today(), datetime.time(23,59,59)))]"/>
                <filter string="Esta Semana"
                        name="semana"
                        domain="[('fecha_visita', '>=', (context_today() - relativedelta(weeks=1)).strftime('%Y-%m-%d'))]"/>
                <filter string="Mis Visitas"
                        name="mis_visitas"
                        domain="[('asesor_id', '=', uid)]"/>
                <separator/>

                <!-- Agrupar por -->
                <group expand="0" string="Agrupar por...">
                    <filter string="Estado"
                            name="group_estado"
                            context="{'group_by': 'estado'}"/>
                    <filter string="Propiedad"
                            name="group_propiedad"
                            context="{'group_by': 'propiedad_id'}"/>
                    <filter string="Prospecto"
                            name="group_prospecto"
                            context="{'group_by': 'prospecto_id'}"/>
                    <filter string="Asesor"
                            name="group_asesor"
                            context="{'group_by': 'asesor_id'}"/>
                    <filter string="Interés"
                            name="group_interes"
                            context="{'group_by': 'interes_prospecto'}"/>
                    <filter string="Próxima Acción"
                            name="group_accion"
                            context="{'group_by': 'proxima_accion'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- ================================================
         ACCIÓN DE VENTANA — VISITAS
    ================================================ -->
    <record id="action_re_visita" model="ir.actions.act_window">
        <field name="name">Visitas</field>
        <field name="res_model">re.visita</field>
        <field name="view_mode">kanban,tree,form,calendar</field>
        <field name="domain">[]</field>
        <field name="context">{
            'search_default_mis_visitas': 1,
            'search_default_agendadas': 0
        }</field>
        <field name="view_ids"
               eval="[(5, 0, 0),
                      (0, 0, {'view_mode': 'kanban',   'view_id': ref('view_re_visita_kanban')}),
                      (0, 0, {'view_mode': 'tree',     'view_id': ref('view_re_visita_tree')}),
                      (0, 0, {'view_mode': 'form',     'view_id': ref('view_re_visita_form')}),
                      (0, 0, {'view_mode': 'calendar', 'view_id': ref('view_re_visita_calendar')})]"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                ¡Agenda tu primera visita!
            </p>
            <p>
                Registra y da seguimiento a las visitas a propiedades.
                Mide la tasa de conversión y el tiempo promedio hasta el cierre.
            </p>
        </field>
    </record>

    <!-- ================================================
         MENÚ — VISITAS
         Posición: entre Prospectos y Contratos
    ================================================ -->
    <menuitem id="menu_re_visitas"
              name="Visitas"
              parent="menu_re_root"
              action="action_re_visita"
              sequence="20"/>

</odoo>