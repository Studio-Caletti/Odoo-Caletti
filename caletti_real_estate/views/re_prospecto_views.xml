<!-- Vista del Vertical Inmobiliario: Prospectos -->

<odoo>

    <!-- ================================================
         TIPO DE ACTIVIDAD PERSONALIZADO: VISITA
         Registra las visitas como mail.activity con
         ícono y nombre específico del vertical.
    ================================================ -->
    <record id="mail_activity_type_visita" model="mail.activity.type">
        <field name="name">Visita a Propiedad</field>
        <field name="icon">fa-home</field>
        <field name="decoration_type">warning</field>
        <field name="delay_count">1</field>
        <field name="delay_unit">days</field>
        <field name="res_model">re.prospecto</field>
    </record>

    <!-- ================================================
         ACCIÓN DE VENTANA — PROSPECTOS
    ================================================ -->
    <record id="action_re_prospecto" model="ir.actions.act_window">
        <field name="name">Prospectos</field>
        <field name="res_model">re.prospecto</field>
        <field name="view_mode">kanban,tree,form</field>
        <field name="context">{'default_asesor_id': uid}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                ¡Registra tu primer prospecto!
            </p>
            <p>
                Gestiona tu pipeline de clientes potenciales:
                desde el primer contacto hasta el cierre del contrato.
            </p>
        </field>
    </record>

    <!-- ================================================
         VISTA KANBAN — PIPELINE DE PROSPECTOS
         Agrupado por etapa. Es la vista principal
         del día a día del asesor inmobiliario.
    ================================================ -->
    <record id="view_re_prospecto_kanban" model="ir.ui.view">
        <field name="name">re.prospecto.kanban</field>
        <field name="model">re.prospecto</field>
        <field name="arch" type="xml">
            <kanban default_group_by="etapa"
                    quick_create="true"
                    class="o_kanban_small_column"
                    sample="1">

                <field name="name"/>
                <field name="etapa"/>
                <field name="calificacion"/>
                <field name="fuente_captacion"/>
                <field name="tipo_interes"/>
                <field name="telefono"/>
                <field name="email"/>
                <field name="asesor_id"/>
                <field name="propiedad_count"/>
                <field name="propiedad_elegida_id"/>
                <field name="presupuesto_max"/>
                <field name="currency_id"/>
                <field name="zona_interes"/>
                <field name="dias_en_pipeline"/>
                <field name="date_cierre_estimado"/>
                <field name="color"/>

                <templates>
                    <t t-name="kanban-box">
                        <div t-attf-class="oe_kanban_color_#{kanban_getcolor(record.color.raw_value)}
                                           oe_kanban_global_click shadow-sm border-rounded mb-2">

                            <div class="oe_kanban_details p-2">

                                <!-- Calificación + tipo interés badges -->
                                <div class="d-flex gap-1 mb-1 flex-wrap">
                                    <span t-if="record.calificacion.raw_value == 'caliente'"
                                          class="badge rounded-pill text-bg-danger"
                                          style="font-size: 0.62rem;">🔥 CALIENTE</span>
                                    <span t-if="record.calificacion.raw_value == 'tibio'"
                                          class="badge rounded-pill text-bg-warning text-dark"
                                          style="font-size: 0.62rem;">🌡️ TIBIO</span>
                                    <span t-if="record.calificacion.raw_value == 'frio'"
                                          class="badge rounded-pill text-bg-secondary"
                                          style="font-size: 0.62rem;">❄️ FRÍO</span>
                                    <span t-if="record.tipo_interes.raw_value == 'renta'"
                                          class="badge rounded-pill text-bg-info text-dark"
                                          style="font-size: 0.62rem;">RENTA</span>
                                    <span t-if="record.tipo_interes.raw_value == 'venta'"
                                          class="badge rounded-pill text-bg-warning text-dark"
                                          style="font-size: 0.62rem;">COMPRA</span>
                                    <span t-if="record.tipo_interes.raw_value == 'ambas'"
                                          class="badge rounded-pill text-bg-primary"
                                          style="font-size: 0.62rem;">RENTA/COMPRA</span>
                                </div>

                                <!-- Nombre del prospecto -->
                                <strong class="o_kanban_record_title">
                                    <field name="name"/>
                                </strong>

                                <!-- Zona de interés -->
                                <div class="text-muted small mt-1"
                                     t-if="record.zona_interes.value">
                                    <i class="fa fa-map-marker me-1" title="Zona"/>
                                    <t t-esc="record.zona_interes.value"/>
                                </div>

                                <!-- Presupuesto máximo -->
                                <div class="mt-1 small"
                                     t-if="record.presupuesto_max.raw_value > 0">
                                    <i class="fa fa-usd me-1" title="Presupuesto"/>
                                    Hasta:
                                    <field name="presupuesto_max"
                                           widget="monetary"/>
                                </div>

                                <!-- Propiedades evaluadas -->
                                <div class="mt-1 small text-muted"
                                     t-if="record.propiedad_count.raw_value > 0">
                                    <i class="fa fa-home me-1" title="Propiedades"/>
                                    <t t-esc="record.propiedad_count.raw_value"/>
                                    propiedad(es) evaluada(s)
                                </div>

                                <!-- Propiedad elegida -->
                                <div class="mt-1 small fw-bold text-success"
                                     t-if="record.propiedad_elegida_id.value">
                                    <i class="fa fa-check-circle me-1" title="Elegida"/>
                                    <field name="propiedad_elegida_id"/>
                                </div>

                                <!-- Días en pipeline -->
                                <div class="mt-1 small"
                                     t-if="record.dias_en_pipeline.raw_value > 0">
                                    <i class="fa fa-clock-o me-1" title="Días"/>
                                    <t t-esc="record.dias_en_pipeline.raw_value"/>
                                    días en pipeline
                                </div>

                                <!-- Footer: fuente y avatar asesor -->
                                <div class="o_kanban_record_bottom mt-2">
                                    <div class="oe_kanban_bottom_left">
                                        <span class="text-muted"
                                              style="font-size: 0.65rem;"
                                              t-if="record.fuente_captacion.value">
                                            <i class="fa fa-share-alt me-1" title="Fuente"/>
                                            <t t-esc="record.fuente_captacion.value"/>
                                        </span>
                                    </div>
                                    <div class="oe_kanban_bottom_right">
                                        <field name="asesor_id"
                                               widget="many2one_avatar_user"/>
                                    </div>
                                </div>

                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- ================================================
         VISTA FORM — PROSPECTO INMOBILIARIO
    ================================================ -->
    <record id="view_re_prospecto_form" model="ir.ui.view">
        <field name="name">re.prospecto.form</field>
        <field name="model">re.prospecto</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <!-- Avanzar pipeline -->
                    <button name="action_avanzar_etapa"
                            string="Avanzar Etapa ▶"
                            type="object"
                            class="oe_highlight"
                            invisible="etapa in ['cerrado', 'descartado']"/>

                    <!-- Agendar visita -->
                    <button name="action_agendar_visita"
                            string="📅 Agendar Visita"
                            type="object"
                            invisible="etapa in ['nuevo', 'cerrado', 'descartado']"/>

                    <!-- Descartar -->
                    <button name="action_descartar"
                            string="❌ Descartar"
                            type="object"
                            invisible="etapa in ['cerrado', 'descartado']"/>

                    <!-- Reactivar -->
                    <button name="action_reactivar"
                            string="🔄 Reactivar"
                            type="object"
                            class="oe_highlight"
                            invisible="etapa != 'descartado'"/>

                    <field name="etapa"
                           widget="statusbar"
                           statusbar_visible="nuevo,contactado,visita_realizada,investigacion,negociacion,cerrado"/>
                </header>

                <sheet>

                    <!-- ALERTA: Descartado -->
                    <div class="alert alert-danger" role="status"
                         invisible="etapa != 'descartado'">
                        <i class="fa fa-times-circle me-2" title="Descartado"/>
                        <strong>Prospecto Descartado.</strong>
                        Motivo:
                        <field name="motivo_descarte"
                               readonly="1"
                               nolabel="1"
                               style="display:inline;"/>
                        Usa <strong>Reactivar</strong> si el prospecto retoma el proceso.
                    </div>

                    <!-- ALERTA: Cerrado sin contrato -->
                    <div class="alert alert-success" role="status"
                         invisible="etapa != 'cerrado'">
                        <i class="fa fa-check-circle me-2" title="Cerrado"/>
                        <strong>¡Pipeline Cerrado!</strong>
                        Propiedad:
                        <field name="propiedad_elegida_id"
                               readonly="1"
                               nolabel="1"
                               style="display:inline;"/>
                        — Genera el contrato desde
                        <strong>Caletti Real Estate → Contratos → Nuevo</strong>.
                    </div>

                    <!-- STAT BUTTONS -->
                    <div class="oe_button_box" name="button_box">
                        <div class="oe_stat_button"
                             icon="fa-home">
                            <field name="propiedad_count"
                                   string="Propiedades"
                                   widget="statinfo"/>
                        </div>
                        <div class="oe_stat_button"
                             icon="fa-clock-o">
                            <field name="dias_en_pipeline"
                                   string="Días Pipeline"
                                   widget="statinfo"/>
                        </div>
                    </div>

                    <!-- TÍTULO -->
                    <div class="oe_title">
                        <label for="name" string="Nombre del Prospecto"/>
                        <h1>
                            <field name="name"
                                   placeholder="Nombre completo o razón social"/>
                        </h1>
                    </div>

                    <!-- DATOS PRINCIPALES -->
                    <group>
                        <group string="Contacto">
                            <field name="partner_id"
                                   widget="res_partner_many2one"/>
                            <field name="telefono"
                                   placeholder="+52 55 1234 5678"/>
                            <field name="email"
                                   placeholder="correo@ejemplo.com"/>
                            <field name="empresa"
                                   placeholder="Solo para prospectos corporativos"/>
                        </group>
                        <group string="Clasificación">
                            <field name="tipo_interes"/>
                            <field name="calificacion"/>
                            <field name="fuente_captacion"/>
                            <field name="asesor_id"
                                   widget="many2one_avatar_user"/>
                        </group>
                    </group>

                    <notebook>

                        <!-- ============================================
                             TAB 1: PROPIEDADES DE INTERÉS
                             Many2many — núcleo del modelo
                        ============================================ -->
                        <page string="🏠 Propiedades Evaluadas"
                              name="tab_propiedades">
                            <div class="alert alert-info" role="status"
                                 invisible="bool(propiedad_ids)">
                                <i class="fa fa-info-circle me-2" title="Info"/>
                                Agrega las propiedades que el prospecto quiere
                                visitar o está evaluando. Puedes agregar varias
                                simultáneamente — el prospecto irá descartando
                                hasta elegir una.
                            </div>
                            <field name="propiedad_ids"
                                   widget="many2many_tags"
                                   options="{'no_create': True}"
                                   domain="[('estado', 'in', ['disponible', 'en_negociacion'])]"
                                   context="{'default_asesor_id': uid}"/>

                            <!-- Propiedad elegida — solo cuando hay propiedades evaluadas -->
                            <group invisible="not propiedad_ids">
                                <field name="propiedad_elegida_id"
                                       domain="[('id', 'in', propiedad_ids)]"
                                       options="{'no_create': True}"
                                       string="Propiedad Elegida para Cierre"/>
                            </group>
                        </page>

                        <!-- ============================================
                             TAB 2: CRITERIOS DE BÚSQUEDA
                        ============================================ -->
                        <page string="🔍 Criterios de Búsqueda"
                              name="tab_criterios">
                            <group>
                                <group string="Preferencias de Zona y Tipo">
                                    <field name="tipo_propiedad_interes"/>
                                    <field name="zona_interes"
                                           placeholder="Del Valle, Narvarte, Roma Norte..."/>
                                    <field name="requiere_estacionamiento"
                                           widget="boolean_toggle"/>
                                    <field name="requiere_amueblado"
                                           widget="boolean_toggle"/>
                                </group>
                                <group string="Capacidad Económica">
                                    <field name="currency_id" invisible="1"/>
                                    <field name="presupuesto_nivel"/>
                                    <field name="presupuesto_min"
                                           widget="monetary"/>
                                    <field name="presupuesto_max"
                                           widget="monetary"/>
                                    <field name="recamaras_min"
                                           invisible="tipo_propiedad_interes not in ['residencial', 'cualquiera']"/>
                                    <field name="m2_min"/>
                                </group>
                            </group>
                            <group string="Notas de Búsqueda">
                                <field name="notas_busqueda"
                                       placeholder="Preferencias específicas: planta baja, mascotas, jardín, uso de suelo, amenidades, etc."
                                       nolabel="1"/>
                            </group>
                        </page>

                        <!-- ============================================
                             TAB 3: FECHAS Y SEGUIMIENTO
                        ============================================ -->
                        <page string="📅 Seguimiento"
                              name="tab_seguimiento">
                            <group>
                                <group string="Fechas del Pipeline">
                                    <field name="date_captacion"/>
                                    <field name="date_contacto"/>
                                    <field name="date_visita"/>
                                    <field name="date_cierre_estimado"/>
                                    <field name="date_cierre_real"
                                           readonly="1"
                                           invisible="not date_cierre_real"/>
                                </group>
                                <group string="Resumen">
                                    <field name="dias_en_pipeline"
                                           readonly="1"/>
                                    <field name="contrato_id"
                                           readonly="1"
                                           invisible="not contrato_id"/>
                                </group>
                            </group>
                        </page>

                        <!-- ============================================
                             TAB 4: INVESTIGACIÓN SOCIOECONÓMICA
                        ============================================ -->
                        <page string="🔍 Investigación"
                              name="tab_investigacion">

                            <!-- Alerta: aprobado -->
                            <div class="alert alert-success" role="status"
                                 invisible="resultado_investigacion != 'aprobado'">
                                <i class="fa fa-check-circle me-2" title="Aprobado"/>
                                <strong>Investigación Aprobada.</strong>
                                El prospecto puede proceder a la firma del contrato.
                            </div>

                            <!-- Alerta: aprobado con observaciones -->
                            <div class="alert alert-warning" role="status"
                                 invisible="resultado_investigacion != 'aprobado_con_obs'">
                                <i class="fa fa-exclamation-triangle me-2" title="Observaciones"/>
                                <strong>Aprobado con Observaciones.</strong>
                                Revisa las notas antes de proceder.
                            </div>

                            <!-- Alerta: rechazado -->
                            <div class="alert alert-danger" role="status"
                                 invisible="resultado_investigacion != 'rechazado'">
                                <i class="fa fa-times-circle me-2" title="Rechazado"/>
                                <strong>Investigación Rechazada.</strong>
                                El prospecto no cumple los requisitos.
                                Considera descartarlo o solicitar aval adicional.
                            </div>

                            <group>
                                <group string="Control de Investigación">
                                    <field name="requiere_investigacion"
                                           widget="boolean_toggle"/>
                                    <field name="investigacion_completada"
                                           widget="boolean_toggle"
                                           invisible="not requiere_investigacion"/>
                                    <field name="resultado_investigacion"
                                           invisible="not requiere_investigacion"/>
                                </group>
                            </group>
                            <group string="Notas y Documentación"
                                   invisible="not requiere_investigacion">
                                <field name="notas_investigacion"
                                       placeholder="Documentos revisados, referencias contactadas, historial crediticio, observaciones..."
                                       nolabel="1"/>
                            </group>
                        </page>

                        <!-- ============================================
                             TAB 5: DESCARTE (visible si aplica)
                        ============================================ -->
                        <page string="❌ Descarte"
                              name="tab_descarte"
                              invisible="etapa != 'descartado'">
                            <group>
                                <field name="motivo_descarte"/>
                                <field name="notas_descarte"
                                       placeholder="Detalle: precio buscado, zona exacta, competidor, etc."/>
                            </group>
                        </page>

                        <!-- ============================================
                             TAB 6: NOTAS GENERALES
                        ============================================ -->
                        <page string="📝 Notas" name="tab_notas">
                            <field name="notas"
                                   placeholder="Observaciones generales del proceso, preferencias especiales, historial de la relación con el prospecto..."
                                   nolabel="1"/>
                        </page>

                    </notebook>
                </sheet>

                <!-- CHATTER: visitas como mail.activity,
                     cambios de etapa y comunicación -->
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>

            </form>
        </field>
    </record>

    <!-- ================================================
         VISTA TREE — PROSPECTOS
    ================================================ -->
    <record id="view_re_prospecto_tree" model="ir.ui.view">
        <field name="name">re.prospecto.tree</field>
        <field name="model">re.prospecto</field>
        <field name="arch" type="xml">
            <tree sample="1"
                  decoration-success="etapa == 'cerrado'"
                  decoration-danger="etapa == 'descartado'"
                  decoration-warning="calificacion == 'caliente' and etapa not in ['cerrado','descartado']"
                  decoration-secondary="etapa == 'descartado'">
                <field name="name"/>
                <field name="telefono"/>
                <field name="tipo_interes"/>
                <field name="calificacion"
                       widget="badge"
                       decoration-danger="calificacion == 'caliente'"
                       decoration-warning="calificacion == 'tibio'"
                       decoration-secondary="calificacion == 'frio'"/>
                <field name="fuente_captacion"/>
                <field name="zona_interes"/>
                <field name="presupuesto_max"
                       widget="monetary"
                       optional="show"/>
                <field name="propiedad_count"/>
                <field name="propiedad_elegida_id" optional="show"/>
                <field name="asesor_id" widget="many2one_avatar_user"/>
                <field name="dias_en_pipeline"/>
                <field name="date_cierre_estimado" optional="show"/>
                <field name="etapa"
                       widget="badge"
                       decoration-info="etapa == 'nuevo'"
                       decoration-warning="etapa in ['contactado','visita_agendada','visita_realizada']"
                       decoration-primary="etapa in ['investigacion','negociacion']"
                       decoration-success="etapa == 'cerrado'"
                       decoration-danger="etapa == 'descartado'"/>
                <field name="currency_id" column_invisible="True"/>
            </tree>
        </field>
    </record>

    <!-- ================================================
         VISTA SEARCH — PROSPECTOS
    ================================================ -->
    <record id="view_re_prospecto_search" model="ir.ui.view">
        <field name="name">re.prospecto.search</field>
        <field name="model">re.prospecto</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="telefono"/>
                <field name="email"/>
                <field name="zona_interes"/>
                <field name="asesor_id"/>
                <field name="propiedad_elegida_id"/>
                <!-- Filtros rápidos por calificación -->
                <filter string="🔥 Calientes"
                        name="calientes"
                        domain="[('calificacion', '=', 'caliente'),
                                 ('etapa', 'not in', ['cerrado','descartado'])]"/>
                <filter string="🌡️ Tibios"
                        name="tibios"
                        domain="[('calificacion', '=', 'tibio'),
                                 ('etapa', 'not in', ['cerrado','descartado'])]"/>
                <separator/>
                <!-- Filtros por etapa -->
                <filter string="🆕 Nuevos"
                        name="nuevos"
                        domain="[('etapa', '=', 'nuevo')]"/>
                <filter string="📅 Visita Agendada"
                        name="visita_agendada"
                        domain="[('etapa', '=', 'visita_agendada')]"/>
                <filter string="🔍 En Investigación"
                        name="investigacion"
                        domain="[('etapa', '=', 'investigacion')]"/>
                <filter string="🤝 En Negociación"
                        name="negociacion"
                        domain="[('etapa', '=', 'negociacion')]"/>
                <filter string="✅ Cerrados"
                        name="cerrados"
                        domain="[('etapa', '=', 'cerrado')]"/>
                <filter string="❌ Descartados"
                        name="descartados"
                        domain="[('etapa', '=', 'descartado')]"/>
                <separator/>
                <!-- Filtros por operación -->
                <filter string="🔑 Buscan Renta"
                        name="buscan_renta"
                        domain="[('tipo_interes', 'in', ['renta','ambas'])]"/>
                <filter string="💰 Buscan Compra"
                        name="buscan_compra"
                        domain="[('tipo_interes', 'in', ['venta','ambas'])]"/>
                <separator/>
                <filter string="Mis Prospectos"
                        name="mis_prospectos"
                        domain="[('asesor_id', '=', uid)]"/>
                <separator/>
                <group expand="0" string="Agrupar por...">
                    <filter string="Etapa"
                            name="group_etapa"
                            context="{'group_by': 'etapa'}"/>
                    <filter string="Calificación"
                            name="group_calif"
                            context="{'group_by': 'calificacion'}"/>
                    <filter string="Fuente de Captación"
                            name="group_fuente"
                            context="{'group_by': 'fuente_captacion'}"/>
                    <filter string="Tipo de Interés"
                            name="group_tipo"
                            context="{'group_by': 'tipo_interes'}"/>
                    <filter string="Asesor"
                            name="group_asesor"
                            context="{'group_by': 'asesor_id'}"/>
                    <filter string="Motivo de Descarte"
                            name="group_descarte"
                            context="{'group_by': 'motivo_descarte'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- ================================================
         MENÚ — PROSPECTOS dentro del vertical inmobiliario
    ================================================ -->
    <menuitem id="menu_re_prospectos"
              name="Prospectos"
              parent="menu_re_root"
              action="action_re_prospecto"
              sequence="20"/>

</odoo>
