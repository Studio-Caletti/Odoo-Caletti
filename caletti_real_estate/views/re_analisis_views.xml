<!-- Vistas de Análisis — Vertical Inmobiliario Caletti Real Estate v1.1 -->

<odoo>

    <!-- ================================================
         ANÁLISIS: PROPIEDADES
         Graph: pie por estado + bar por operacion_objetivo
         Pivot: cruce libre por tipo, estado, asesor
    ================================================ -->

    <record id="view_re_propiedad_graph" model="ir.ui.view">
        <field name="name">re.propiedad.graph</field>
        <field name="model">re.propiedad</field>
        <field name="arch" type="xml">
            <graph string="Análisis de Propiedades"
                   type="pie"
                   sample="1">
                <field name="estado" type="row"/>
            </graph>
        </field>
    </record>

    <record id="view_re_propiedad_pivot" model="ir.ui.view">
        <field name="name">re.propiedad.pivot</field>
        <field name="model">re.propiedad</field>
        <field name="arch" type="xml">
            <pivot string="Análisis de Propiedades"
                   sample="1"
                   display_quantity="1">
                <field name="tipo_propiedad" type="row"/>
                <field name="estado"         type="col"/>
                <field name="operacion_objetivo" type="row"/>
            </pivot>
        </field>
    </record>

    <record id="action_re_analisis_propiedades"
            model="ir.actions.act_window">
        <field name="name">Propiedades</field>
        <field name="res_model">re.propiedad</field>
        <field name="view_mode">graph,pivot</field>
        <field name="context">{
            'search_default_group_estado': 1
        }</field>
        <field name="view_ids"
               eval="[(5, 0, 0),
                      (0, 0, {'view_mode': 'graph',
                              'view_id': ref('view_re_propiedad_graph')}),
                      (0, 0, {'view_mode': 'pivot',
                              'view_id': ref('view_re_propiedad_pivot')})]"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Sin propiedades registradas aún.
            </p>
        </field>
    </record>

    <!-- ================================================
         ANÁLISIS: CONTRATOS
         Graph: pie por estado + bar por operacion_objetivo
         Pivot: cruce libre por tipo, estado, asesor
    ================================================ -->

    <record id="view_re_propiedad_graph" model="ir.ui.view">
        <field name="name">re.contrato.graph</field>
        <field name="model">re.contrato</field>
        <field name="arch" type="xml">
            <graph string="Análisis de Contratos"
                   type="pie"
                   sample="1">
                <field name="estado" type="row"/>
            </graph>
        </field>
    </record>

    <record id="view_re_propiedad_pivot" model="ir.ui.view">
        <field name="name">re.contrato.pivot</field>
        <field name="model">re.contrato</field>
        <field name="arch" type="xml">
            <pivot string="Análisis de Conratos"
                   sample="1"
                   display_quantity="1">
                <field name="tipo_operacion" type="row"/>
                <field name="estado"         type="col"/>
                <field name="operacion_objetivo" type="row"/>
            </pivot>
        </field>
    </record>

    <record id="action_re_analisis_contratos"
            model="ir.actions.act_window">
        <field name="name">Contratos</field>
        <field name="res_model">re.contrato</field>
        <field name="view_mode">graph,pivot</field>
        <field name="context">{
            'search_default_group_estado': 1
        }</field>
        <field name="view_ids"
               eval="[(5, 0, 0),
                      (0, 0, {'view_mode': 'graph',
                              'view_id': ref('view_re_contrato_graph')}),
                      (0, 0, {'view_mode': 'pivot',
                              'view_id': ref('view_re_contrato_pivot')})]"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Sin propiedades contratos aún.
            </p>
        </field>
    </record>

    <!-- ================================================
         ANÁLISIS: PROSPECTOS
         Graph: bar por etapa del pipeline
         Pivot: cruce por calificación, fuente, asesor
    ================================================ -->

    <record id="view_re_prospecto_graph" model="ir.ui.view">
        <field name="name">re.prospecto.graph</field>
        <field name="model">re.prospecto</field>
        <field name="arch" type="xml">
            <graph string="Pipeline de Prospectos"
                   type="bar"
                   sample="1">
                <field name="etapa" type="row"/>
            </graph>
        </field>
    </record>

    <record id="view_re_prospecto_pivot" model="ir.ui.view">
        <field name="name">re.prospecto.pivot</field>
        <field name="model">re.prospecto</field>
        <field name="arch" type="xml">
            <pivot string="Pipeline de Prospectos"
                   sample="1"
                   display_quantity="1">
                <field name="etapa"            type="row"/>
                <field name="calificacion"     type="col"/>
                <field name="fuente_captacion" type="row"/>
            </pivot>
        </field>
    </record>

    <record id="action_re_analisis_prospectos"
            model="ir.actions.act_window">
        <field name="name">Prospectos</field>
        <field name="res_model">re.prospecto</field>
        <field name="view_mode">graph,pivot</field>
        <field name="context">{
            'search_default_group_etapa': 1
        }</field>
        <field name="view_ids"
               eval="[(5, 0, 0),
                      (0, 0, {'view_mode': 'graph',
                              'view_id': ref('view_re_prospecto_graph')}),
                      (0, 0, {'view_mode': 'pivot',
                              'view_id': ref('view_re_prospecto_pivot')})]"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Sin prospectos registrados aún.
            </p>
        </field>
    </record>

    <!-- ================================================
         ANÁLISIS: VISITAS
         Graph: bar por estado + conversión
         Pivot: cruce por propiedad, asesor, interés
    ================================================ -->

    <record id="view_re_visita_graph" model="ir.ui.view">
        <field name="name">re.visita.graph</field>
        <field name="model">re.visita</field>
        <field name="arch" type="xml">
            <graph string="Análisis de Visitas"
                   type="bar"
                   sample="1">
                <field name="estado" type="row"/>
            </graph>
        </field>
    </record>

    <record id="view_re_visita_pivot" model="ir.ui.view">
        <field name="name">re.visita.pivot</field>
        <field name="model">re.visita</field>
        <field name="arch" type="xml">
            <pivot string="Análisis de Visitas"
                   sample="1"
                   display_quantity="1">
                <field name="propiedad_id"      type="row"/>
                <field name="estado"            type="col"/>
                <field name="interes_prospecto" type="row"/>
            </pivot>
        </field>
    </record>

    <record id="action_re_analisis_visitas"
            model="ir.actions.act_window">
        <field name="name">Visitas</field>
        <field name="res_model">re.visita</field>
        <field name="view_mode">graph,pivot</field>
        <field name="context">{
            'search_default_group_estado': 1
        }</field>
        <field name="view_ids"
               eval="[(5, 0, 0),
                      (0, 0, {'view_mode': 'graph',
                              'view_id': ref('view_re_visita_graph')}),
                      (0, 0, {'view_mode': 'pivot',
                              'view_id': ref('view_re_visita_pivot')})]"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Sin visitas registradas aún.
            </p>
        </field>
    </record>

    <!-- ================================================
         MENÚ ANÁLISIS
         Menú padre + tres submenús
         sequence=60 — después de Historial (sequence=55)
    ================================================ -->

    <menuitem id="menu_re_analisis"
              name="Análisis"
              parent="menu_re_root"
              sequence="60"/>

    <menuitem id="menu_re_analisis_propiedades"
              name="Propiedades"
              parent="menu_re_analisis"
              action="action_re_analisis_propiedades"
              sequence="10"/>

    <menuitem id="menu_re_analisis_prospectos"
              name="Contratos"
              parent="menu_re_analisis"
              action="action_re_analisis_prospectos"
              sequence="20"/>

    <menuitem id="menu_re_analisis_prospectos"
              name="Prospectos"
              parent="menu_re_analisis"
              action="action_re_analisis_prospectos"
              sequence="30"/>

    <menuitem id="menu_re_analisis_visitas"
              name="Visitas"
              parent="menu_re_analisis"
              action="action_re_analisis_visitas"
              sequence="40"/>

</odoo>