<!-- Vista del Vertical Inmobiliario: Propiedades -->

<odoo>

    <!-- ================================================
         ACCIÓN DE VENTANA — PROPIEDADES
    ================================================ -->
    <record id="action_re_propiedad" model="ir.actions.act_window">
        <field name="name">Propiedades</field>
        <field name="res_model">re.propiedad</field>
        <field name="view_mode">kanban,tree,form</field>
        <field name="context">{'default_asesor_id': uid}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                ¡Registra tu primera propiedad!
            </p>
            <p>
                Gestiona tu cartera de propiedades residenciales,
                comerciales y terrenos desde un solo lugar.
            </p>
        </field>
    </record>

    <!-- ================================================
         VISTA KANBAN — PROPIEDADES
         Agrupada por estado del ciclo de vida.
         Cards con foto de portada, precio y datos clave.
    ================================================ -->
    <record id="view_re_propiedad_kanban" model="ir.ui.view">
        <field name="name">re.propiedad.kanban</field>
        <field name="model">re.propiedad</field>
        <field name="arch" type="xml">
            <kanban default_group_by="estado"
                    quick_create="false"
                    class="o_kanban_small_column"
                    sample="1">

                <field name="name"/>
                <field name="estado"/>
                <field name="tipo_propiedad"/>
                <field name="subtipo_propiedad"/>
                <field name="operacion_objetivo"/>
                <field name="propietario_id"/>
                <field name="asesor_id"/>
                <field name="precio_renta"/>
                <field name="precio_venta"/>
                <field name="m2_construccion"/>
                <field name="m2_terreno"/>
                <field name="recamaras"/>
                <field name="banos"/>
                <field name="colonia"/>
                <field name="municipio"/>
                <field name="foto_ids"/>
                <field name="foto_count"/>
                <field name="currency_id"/>
                <field name="color"/>

                <templates>
                    <t t-name="kanban-box">
                        <div t-attf-class="oe_kanban_color_#{kanban_getcolor(record.color.raw_value)}
                                           oe_kanban_global_click shadow-sm border-rounded mb-2">

                            <div class="oe_kanban_details p-2">

                                <!-- Tipo + operación badges -->
                                <div class="d-flex gap-1 mb-1 flex-wrap">
                                    <span class="badge rounded-pill text-bg-secondary"
                                          style="font-size: 0.62rem;">
                                        <t t-esc="record.tipo_propiedad.value or 'Sin tipo'"/>
                                    </span>
                                    <span t-if="record.operacion_objetivo.raw_value == 'renta'"
                                          class="badge rounded-pill text-bg-info text-dark"
                                          style="font-size: 0.62rem;">RENTA</span>
                                    <span t-if="record.operacion_objetivo.raw_value == 'venta'"
                                          class="badge rounded-pill text-bg-warning text-dark"
                                          style="font-size: 0.62rem;">VENTA</span>
                                    <span t-if="record.operacion_objetivo.raw_value == 'ambas'"
                                          class="badge rounded-pill text-bg-primary"
                                          style="font-size: 0.62rem;">RENTA+VENTA</span>
                                </div>

                                <!-- Nombre -->
                                <strong class="o_kanban_record_title">
                                    <field name="name"/>
                                </strong>

                                <!-- Ubicación -->
                                <div class="text-muted small mt-1"
                                     t-if="record.colonia.value or record.municipio.value">
                                    <i class="fa fa-map-marker me-1" title="Ubicación"/>
                                    <t t-if="record.colonia.value">
                                        <t t-esc="record.colonia.value"/>
                                    </t>
                                    <t t-if="record.colonia.value and record.municipio.value">, </t>
                                    <t t-if="record.municipio.value">
                                        <t t-esc="record.municipio.value"/>
                                    </t>
                                </div>

                                <!-- Características rápidas -->
                                <div class="d-flex gap-2 mt-2 small text-muted">
                                    <span t-if="record.m2_construccion.raw_value">
                                        <i class="fa fa-building-o me-1" title="Construcción"/>
                                        <t t-esc="'%.0f' % record.m2_construccion.raw_value"/>m²
                                    </span>
                                    <span t-if="record.recamaras.raw_value">
                                        <i class="fa fa-bed me-1" title="Recámaras"/>
                                        <t t-esc="record.recamaras.raw_value"/>rec
                                    </span>

                                    <span t-if="record.banos.raw_value">
                                        <i class="fa fa-bed me-1" title="Baños"/>
                                        <field name="banos"/>
                                    <!--<span t-if="record.banos.raw_value">
                                        <i class="fa fa-bath me-1" title="Baños"/>
                                        <t t-esc="'%.1f' % record.banos.raw_value"/>
                                    </span> -->
                                    <span t-if="record.foto_count.raw_value > 0"
                                          class="ms-auto">
                                        <i class="fa fa-camera me-1" title="Fotos"/>
                                        <t t-esc="record.foto_count.raw_value"/>
                                    </span>
                                </div>

                                <!-- Precios -->
                                <div class="mt-2">
                                    <div t-if="record.precio_renta.raw_value > 0"
                                         class="fw-bold" style="font-size: 0.85rem;">
                                        <i class="fa fa-key me-1" title="Renta"/>
                                        <field name="precio_renta" widget="monetary"/>
                                        <span class="text-muted fw-normal">/mes</span>
                                    </div>
                                    <div t-if="record.precio_venta.raw_value > 0"
                                         class="fw-bold" style="font-size: 0.85rem;">
                                        <i class="fa fa-usd me-1" title="Venta"/>
                                        <field name="precio_venta" widget="monetary"/>
                                    </div>
                                </div>

                                <!-- Footer: propietario y asesor -->
                                <div class="o_kanban_record_bottom mt-2">
                                    <div class="oe_kanban_bottom_left">
                                        <span class="text-muted" style="font-size:0.7rem;">
                                            <i class="fa fa-user-o me-1" title="Propietario"/>
                                            <field name="propietario_id"/>
                                        </span>
                                    </div>
                                    <div class="oe_kanban_bottom_right">
                                        <field name="asesor_id"
                                               widget="many2one_avatar_user"/>
                                    </div>
                                </div>

                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- ================================================
         VISTA FORM — PROPIEDAD INMOBILIARIA
         Secciones: identificación, clasificación, estado,
         ubicación, características (con invisible por tipo),
         condiciones económicas, fotos, descripción.
    ================================================ -->
    <record id="view_re_propiedad_form" model="ir.ui.view">
        <field name="name">re.propiedad.form</field>
        <field name="model">re.propiedad</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <!-- Acciones rápidas de estado -->
                    <button name="action_marcar_disponible"
                            string="Marcar Disponible"
                            type="object"
                            class="oe_highlight"
                            invisible="estado == 'disponible'"/>
                    <button name="action_marcar_suspendida"
                            string="Suspender"
                            type="object"
                            invisible="estado in ['suspendida', 'vendida']"/>
                    <field name="estado"
                           widget="statusbar"
                           statusbar_visible="disponible,en_negociacion,ocupada,vendida"/>
                </header>

                <sheet>

                    <!-- ALERTA: En mantenimiento -->
                    <div class="alert alert-warning" role="status"
                         invisible="estado != 'en_mantenimiento'">
                        <i class="fa fa-wrench me-2" title="Mantenimiento"/>
                        <strong>Propiedad en Mantenimiento.</strong>
                        No disponible para operación hasta nuevo aviso.
                        Trabajo en curso:
                        <field name="tipo_mantenimiento"
                               readonly="1"
                               nolabel="1"
                               style="display:inline;"/>
                    </div>

                    <!-- ALERTA: Suspendida -->
                    <div class="alert alert-danger" role="status"
                         invisible="estado != 'suspendida'">
                        <i class="fa fa-ban me-2" title="Suspendida"/>
                        <strong>Propiedad Suspendida.</strong>
                        El propietario ha retirado el inmueble del mercado temporalmente.
                    </div>

                    <!-- STAT BUTTONS -->

                    <button class="oe_stat_button" icon="fa-camera" name="action_view_photos" type="object">
                        <field name="foto_count"
                             string="Fotos" 
                             widget="statinfo"/>
                    </button>

                <!--    <div class="oe_button_box" name="button_box">
                        <div class="oe_stat_button" icon="fa-camera">
                            <field name="foto_count"
                                   string="Fotos"
                                   widget="statinfo"/>
                        </div>
                    </div> -->

                    <!-- TÍTULO -->
                    <div class="oe_title">
                        <label for="name" string="Nombre / Referencia"/>
                        <h1>
                            <field name="name"
                                   placeholder="Ej: Casa Pedregal 3 recámaras · Local Insurgentes PB"/>
                        </h1>
                        <field name="referencia_interna"
                               placeholder="Clave interna: RE-2026-001"
                               style="font-size: 0.9rem; color: var(--o-form-field-color-muted);"/>
                    </div>

                    <!-- DATOS PRINCIPALES -->
                    <group>
                        <group string="Clasificación">
                            <field name="tipo_propiedad"/>
                            <field name="subtipo_propiedad"/>
                            <field name="operacion_objetivo"/>
                        </group>
                        <group string="Responsabilidades">
                            <field name="propietario_id"
                                   widget="res_partner_many2one"/>
                            <field name="asesor_id"
                                   widget="many2one_avatar_user"/>
                            <field name="date_disponible"/>
                        </group>
                    </group>

                    <notebook>

                        <!-- ============================================
                             TAB 1: UBICACIÓN
                        ============================================ -->
                        <page string="📍 Ubicación" name="tab_ubicacion">
                            <group>
                                <group string="Dirección">
                                    <field name="calle"
                                           placeholder="Calle y número exterior/interior"/>
                                    <field name="colonia"
                                           placeholder="Colonia o Fraccionamiento"/>
                                    <field name="municipio"
                                           placeholder="Municipio o Alcaldía"/>
                                    <field name="estado_geografico"
                                           placeholder="Estado o Provincia"/>
                                    <field name="codigo_postal"/>
                                    <field name="country_id"/>
                                </group>
                                <group string="Referencia Digital">
                                    <field name="maps_url"
                                           placeholder="https://maps.google.com/..."/>
                                    <field name="direccion_completa"
                                           readonly="1"/>
                                </group>
                            </group>
                        </page>

                        <!-- ============================================
                             TAB 2: CARACTERÍSTICAS FÍSICAS
                             Campos condicionales via invisible por tipo
                        ============================================ -->
                        <page string="🏠 Características" name="tab_caracteristicas">

                            <!-- Residencial: todos los campos habitacionales -->
                            <group string="Residencial"
                                   invisible="tipo_propiedad != 'residencial'">
                                <group>
                                    <field name="recamaras"/>
                                    <field name="banos"/>
                                    <field name="medios_banos"/>
                                    <field name="niveles"/>
                                    <field name="nivel_piso"
                                           invisible="subtipo_propiedad not in ['departamento','penthouse','estudio']"/>
                                </group>
                                <group>
                                    <field name="m2_construccion"/>
                                    <field name="m2_terreno"
                                           invisible="subtipo_propiedad not in ['casa','townhouse']"/>
                                    <field name="estacionamientos"/>
                                    <field name="amueblado"/>
                                    <field name="anio_construccion"/>
                                </group>
                            </group>

                            <!-- Comercial: campos de negocio -->
                            <group string="Comercial"
                                   invisible="tipo_propiedad != 'comercial'">
                                <group>
                                    <field name="m2_construccion"/>
                                    <field name="m2_terreno"/>
                                    <field name="nivel_piso"
                                           invisible="subtipo_propiedad != 'oficina'"/>
                                    <field name="altura_bodega"
                                           invisible="subtipo_propiedad not in ['bodega','nave_industrial']"/>
                                </group>
                                <group>
                                    <field name="estacionamientos"/>
                                    <field name="uso_suelo"/>
                                    <field name="amueblado"/>
                                    <field name="anio_construccion"/>
                                </group>
                            </group>

                            <!-- Terreno: solo superficies y uso de suelo -->
                            <group string="Terreno"
                                   invisible="tipo_propiedad != 'terreno'">
                                <group>
                                    <field name="m2_terreno"/>
                                    <field name="uso_suelo"/>
                                </group>
                                <group>
                                    <field name="maps_url"
                                           placeholder="Link Maps del terreno"/>
                                </group>
                            </group>

                            <!-- Amenidades — todos los tipos -->
                            <div>
                                <strong>AMENIDADES y SERVICIOS EXTRAS</strong>
                                <field name="amenidades"
                                       placeholder="Piscina, gimnasio, seguridad 24h, cisterna, paneles solares, jardín, terraza..."
                                       nolabel="1"/>
                            </div>


                            <!-- <group string="Amenidades y Extras">
                                <field name="amenidades"
                                       placeholder="Piscina, gimnasio, seguridad 24h, cisterna, paneles solares, jardín, terraza..."
                                       nolabel="1"/>
                            </group> -->

                        </page>

                        <!-- ============================================
                             TAB 3: CONDICIONES ECONÓMICAS
                        ============================================ -->
                        <page string="💰 Condiciones" name="tab_condiciones">
                            <group>
                                <group string="Precios">
                                    <field name="currency_id" invisible="1"/>
                                    <field name="precio_renta"
                                           widget="monetary"
                                           invisible="operacion_objetivo == 'venta'"/>
                                    <field name="precio_venta"
                                           widget="monetary"
                                           invisible="operacion_objetivo == 'renta'"/>
                                    <field name="precio_negociable"/>
                                    <field name="deposito_requerido"
                                           widget="monetary"
                                           invisible="operacion_objetivo == 'venta'"/>
                                </group>
                                <group string="Comisión del Asesor">
                                    <field name="comision_pct"/>
                                    <field name="comision_estimada_venta"
                                           widget="monetary"
                                           readonly="1"
                                           invisible="operacion_objetivo == 'renta'"/>
                                    <field name="comision_estimada_renta"
                                           widget="monetary"
                                           readonly="1"
                                           invisible="operacion_objetivo == 'venta'"/>
                                </group>
                            </group>
                        </page>

                        <!-- ============================================
                             TAB 4: MANTENIMIENTO
                             Visible siempre — activo cuando estado = en_mantenimiento
                        ============================================ -->
                        <page string="🔧 Mantenimiento" name="tab_mantenimiento">
                            <div class="alert alert-info" role="status"
                                 invisible="estado == 'en_mantenimiento'">
                                <i class="fa fa-info-circle me-2" title="Info"/>
                                Registra aquí el tipo y descripción del mantenimiento.
                                Cambia el estado a <strong>En Mantenimiento</strong>
                                desde el header para activar la alerta visual.
                            </div>
                            <group>
                                <group string="Tipo de Trabajo">
                                    <field name="tipo_mantenimiento"/>
                                    <field name="date_fin_mantenimiento"/>
                                </group>
                                <group string="Descripción">
                                    <field name="notas_mantenimiento"
                                           placeholder="Alcance del trabajo, materiales, contratista, avance, notas relevantes..."
                                           nolabel="1"/>
                                </group>
                            </group>
                        </page>

                        <!-- ============================================
                             TAB 5: GALERÍA DE FOTOS
                             Submodelo re.propiedad.foto — límite MAX_FOTOS_PROPIEDAD
                        ============================================ -->
                        <page string="📷 Fotos" name="tab_fotos">
                            <div class="alert alert-info" role="status">
                                <i class="fa fa-camera me-2" title="Fotos"/>
                                <strong>Guía para subir fotos:</strong>
                                Formato JPG o PNG ·
                                Resolución recomendada: <strong>1920 × 1080 px</strong> (horizontal)
                                o <strong>1080 × 1920 px</strong> (vertical) ·
                                Peso máximo: <strong>5 MB</strong> por imagen ·
                                Máximo <strong>10 fotos</strong> por propiedad.
                                Marca una como <strong>Portada</strong> para que aparezca primero.
                            </div>
                            <field name="foto_ids"
                                   context="{'default_propiedad_id': active_id}">
                                <tree editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="imagen"
                                           widget="image"
                                           options="{'size': [64, 64]}"/>
                                    <field name="name"
                                           placeholder="Ej: Sala principal, Fachada, Cocina..."/>
                                    <field name="es_portada"
                                           widget="boolean_toggle"/>
                                </tree>
                            </field>
                        </page>

                        <!-- ============================================
                             TAB 6: DESCRIPCIÓN Y PORTAL
                        ============================================ -->
                        <page string="📝 Descripción" name="tab_descripcion">
                            <group string="Texto para Portal / Anuncio">
                                <field name="descripcion_portal"
                                       placeholder="Descripción atractiva del inmueble para publicar en portales y redes. Destaca la ubicación, acabados, amenidades y puntos únicos..."
                                       nolabel="1"/>
                            </group>
                            <group string="Notas Internas (solo visible al asesor)">
                                <field name="notas_internas"
                                       placeholder="Acceso, código de llave, condiciones especiales del propietario, historial de inquilinos, comentarios privados..."
                                       nolabel="1"/>
                            </group>
                        </page>

                    </notebook>
                </sheet>

                <!-- CHATTER: trazabilidad de cambios de estado,
                     visitas agendadas (mail.activity) y comunicación -->
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>

            </form>
        </field>
    </record>

    <!-- ================================================
         VISTA TREE — PROPIEDADES
    ================================================ -->
    <record id="view_re_propiedad_tree" model="ir.ui.view">
        <field name="name">re.propiedad.tree</field>
        <field name="model">re.propiedad</field>
        <field name="arch" type="xml">
            <tree sample="1"
                  decoration-success="estado == 'disponible'"
                  decoration-info="estado == 'en_negociacion'"
                  decoration-warning="estado == 'en_mantenimiento'"
                  decoration-danger="estado == 'suspendida'"
                  decoration-muted="estado == 'vendida'">
                <field name="name"/>
                <field name="referencia_interna"/>
                <field name="tipo_propiedad"/>
                <field name="subtipo_propiedad"/>
                <field name="operacion_objetivo"/>
                <field name="colonia"/>
                <field name="municipio"/>
                <field name="propietario_id"/>
                <field name="asesor_id" widget="many2one_avatar_user"/>
                <field name="precio_renta"
                       widget="monetary"
                       optional="show"/>
                <field name="precio_venta"
                       widget="monetary"
                       optional="show"/>
                <field name="m2_construccion" optional="show"/>
                <field name="recamaras" optional="show"/>
                <field name="foto_count" optional="show"/>
                <field name="estado"
                       widget="badge"
                       decoration-success="estado == 'disponible'"
                       decoration-info="estado == 'en_negociacion'"
                       decoration-primary="estado == 'ocupada'"
                       decoration-warning="estado == 'en_mantenimiento'"
                       decoration-danger="estado == 'suspendida'"/>
                <field name="date_disponible"/>
                <field name="currency_id" column_invisible="True"/>
            </tree>
        </field>
    </record>

    <!-- ================================================
         VISTA SEARCH — PROPIEDADES
    ================================================ -->
    <record id="view_re_propiedad_search" model="ir.ui.view">
        <field name="name">re.propiedad.search</field>
        <field name="model">re.propiedad</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="referencia_interna"/>
                <field name="propietario_id"/>
                <field name="asesor_id"/>
                <field name="colonia"/>
                <field name="municipio"/>
                <!-- Filtros rápidos -->
                <filter string="Mis Propiedades"
                        name="mis_propiedades"
                        domain="[('asesor_id', '=', uid)]"/>
                <separator/>
                <filter string="🟢 Disponibles"
                        name="disponibles"
                        domain="[('estado', '=', 'disponible')]"/>
                <filter string="🟡 En Negociación"
                        name="en_negociacion"
                        domain="[('estado', '=', 'en_negociacion')]"/>
                <filter string="🔵 Ocupadas"
                        name="ocupadas"
                        domain="[('estado', '=', 'ocupada')]"/>
                <filter string="🔧 En Mantenimiento"
                        name="en_mantenimiento"
                        domain="[('estado', '=', 'en_mantenimiento')]"/>
                <filter string="⛔ Suspendidas"
                        name="suspendidas"
                        domain="[('estado', '=', 'suspendida')]"/>
                <separator/>
                <filter string="🔑 Solo Renta"
                        name="solo_renta"
                        domain="[('operacion_objetivo', 'in', ['renta', 'ambas'])]"/>
                <filter string="💰 Solo Venta"
                        name="solo_venta"
                        domain="[('operacion_objetivo', 'in', ['venta', 'ambas'])]"/>
                <separator/>
                <filter string="🏠 Residencial"
                        name="residencial"
                        domain="[('tipo_propiedad', '=', 'residencial')]"/>
                <filter string="🏢 Comercial"
                        name="comercial"
                        domain="[('tipo_propiedad', '=', 'comercial')]"/>
                <filter string="🌿 Terrenos"
                        name="terrenos"
                        domain="[('tipo_propiedad', '=', 'terreno')]"/>
                <separator/>
                <group expand="0" string="Agrupar por...">
                    <filter string="Estado"
                            name="group_estado"
                            context="{'group_by': 'estado'}"/>
                    <filter string="Tipo de Propiedad"
                            name="group_tipo"
                            context="{'group_by': 'tipo_propiedad'}"/>
                    <filter string="Operación"
                            name="group_operacion"
                            context="{'group_by': 'operacion_objetivo'}"/>
                    <filter string="Propietario"
                            name="group_propietario"
                            context="{'group_by': 'propietario_id'}"/>
                    <filter string="Asesor"
                            name="group_asesor"
                            context="{'group_by': 'asesor_id'}"/>
                    <filter string="Municipio"
                            name="group_municipio"
                            context="{'group_by': 'municipio'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- ================================================
         ESTRUCTURA DE MENÚS — VERTICAL INMOBILIARIO
         groups="caletti_real_estate.group_re_asesor,
                      caletti_real_estate.group_re_admin"
    ================================================ -->

    <menuitem id="menu_re_root"
              name="Caletti Real Estate"
              web_icon="caletti_real_estate,static/description/icon.png"
              sequence="6"/>

    <menuitem id="menu_re_propiedades"
              name="Propiedades"
              parent="menu_re_root"
              action="action_re_propiedad"
              sequence="10"/>

</odoo>
