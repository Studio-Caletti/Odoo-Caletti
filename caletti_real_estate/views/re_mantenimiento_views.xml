<!-- Vista del Vertical Inmobiliario: Mantenimiento -->

<odoo>

    <!-- ================================================
         SECUENCIA: REFERENCIA DE TICKET
         Genera MANT-2026-00001 automáticamente al crear
    ================================================ -->
    <record id="seq_re_mantenimiento" model="ir.sequence">
        <field name="name">Mantenimiento — Referencia de Ticket</field>
        <field name="code">re.mantenimiento</field>
        <field name="prefix">MANT-%(year)s-</field>
        <field name="padding">5</field>
        <field name="number_increment">1</field>
        <field name="number_next">1</field>
        <field name="implementation">standard</field>
    </record>

    <!-- ================================================
         ACCIÓN — MANTENIMIENTO
    ================================================ -->
    <record id="action_re_mantenimiento" model="ir.actions.act_window">
        <field name="name">Mantenimiento</field>
        <field name="res_model">re.mantenimiento</field>
        <field name="view_mode">kanban,tree,form</field>
        <field name="context">{'search_default_activos': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                ¡Registra el primer mantenimiento!
            </p>
            <p>
                Gestiona solicitudes de mantenimiento para toda tu cartera:
                propiedades vacantes, ocupadas o en remodelación.
            </p>
        </field>
    </record>

    <!-- ================================================
         VISTA FORM — MANTENIMIENTO
    ================================================ -->
    <record id="view_re_mantenimiento_form" model="ir.ui.view">
        <field name="name">re.mantenimiento.form</field>
        <field name="model">re.mantenimiento</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_iniciar_evaluacion"
                            string="🔍 Iniciar Evaluación"
                            type="object"
                            class="oe_highlight"
                            invisible="estado != 'solicitado'"/>
                    <button name="action_aprobar"
                            string="✅ Aprobar"
                            type="object"
                            class="oe_highlight"
                            invisible="estado != 'evaluando'"/>
                    <button name="action_iniciar_trabajo"
                            string="🔄 Iniciar Trabajo"
                            type="object"
                            class="oe_highlight"
                            invisible="estado not in ['aprobado','evaluando']"/>
                    <button name="action_marcar_resuelto"
                            string="🏁 Marcar Resuelto"
                            type="object"
                            class="oe_highlight"
                            invisible="estado != 'en_proceso'"/>
                    <button name="action_cerrar"
                            string="📦 Cerrar"
                            type="object"
                            invisible="estado != 'resuelto'"/>
                    <button name="action_cancelar"
                            string="❌ Cancelar"
                            type="object"
                            invisible="estado in ['resuelto','cerrado','cancelado']"/>
                    <field name="estado"
                           widget="statusbar"
                           statusbar_visible="solicitado,evaluando,aprobado,en_proceso,resuelto,cerrado"/>
                </header>

                <sheet>

                    <!-- ALERTA: Aprobación requerida -->
                    <div class="alert alert-warning" role="status"
                         invisible="not requiere_aprobacion or aprobado_por_propietario">
                        <i class="fa fa-exclamation-triangle me-2" title="Aprobación"/>
                        <strong>Se requiere aprobación del propietario.</strong>
                        El costo estimado supera el umbral de autorización.
                        Contacta al propietario antes de iniciar el trabajo.
                    </div>

                    <!-- ALERTA: Urgente -->
                    <div class="alert alert-danger" role="status"
                         invisible="prioridad != 'urgente' or estado in ['resuelto','cerrado','cancelado']">
                        <i class="fa fa-exclamation-circle me-2" title="Urgente"/>
                        <strong>¡Mantenimiento URGENTE!</strong>
                        Riesgo para la propiedad o el inquilino.
                        Atención inmediata requerida.
                    </div>

                    <!-- STAT BUTTONS -->
                    <div class="oe_button_box" name="button_box">
                        <div class="oe_stat_button" icon="fa-ticket">
                            <div class="o_stat_info">
                                <span class="o_stat_value"
                                      style="font-size: 0.9rem;">
                                    <field name="ticket_ref" readonly="1"/>
                                </span>
                                <span class="o_stat_text">Ticket</span>
                            </div>
                        </div>
                        <div class="oe_stat_button" icon="fa-clock-o">
                            <field name="dias_resolucion"
                                   string="Días"
                                   widget="statinfo"/>
                        </div>
                    </div>

                    <!-- TÍTULO -->
                    <div class="oe_title">
                        <label for="name" string="Descripción del Mantenimiento"/>
                        <h1>
                            <field name="name"
                                   placeholder="Ej: Fuga en tubería cocina · Pintura exterior · Cambio de chapa"/>
                        </h1>
                    </div>

                    <!-- CABECERA: propiedad, categoría, prioridad -->
                    <group>
                        <group string="Propiedad y Vínculo">
                            <field name="propiedad_id"
                                   options="{'no_create': True}"/>
                            <field name="propietario_id" readonly="1"/>
                            <field name="contrato_id"
                                   domain="[('propiedad_id', '=', propiedad_id),
                                            ('estado', 'in', ['activo','por_vencer'])]"
                                   options="{'no_create': True}"/>
                            <field name="inquilino_id"
                                   readonly="1"
                                   invisible="not inquilino_id"/>
                        </group>
                        <group string="Clasificación">
                            <field name="categoria"/>
                            <field name="prioridad"/>
                            <field name="origen_solicitud"/>
                            <field name="asesor_id"
                                   widget="many2one_avatar_user"
                                   readonly="1"/>
                        </group>
                    </group>

                    <notebook>

                        <!-- ============================================
                             TAB 1: EJECUTOR
                        ============================================ -->
                        <page string="🔧 Ejecutor" name="tab_ejecutor">
                            <group>
                                <group string="Tipo de Ejecución">
                                    <field name="tipo_ejecutor"
                                           widget="radio"/>
                                </group>
                                <group string="Datos del Proveedor"
                                       invisible="tipo_ejecutor != 'proveedor_externo'">
                                    <field name="proveedor_id"
                                           widget="res_partner_many2one"
                                           options="{'no_create': False}"/>
                                    <field name="proveedor_nombre"
                                           placeholder="Nombre manual si no está en Odoo"
                                           invisible="bool(proveedor_id)"/>
                                    <field name="proveedor_telefono"
                                           placeholder="+52 55 1234 5678"/>
                                </group>
                            </group>
                        </page>

                        <!-- ============================================
                             TAB 2: FECHAS
                        ============================================ -->
                        <page string="📅 Fechas" name="tab_fechas">
                            <group>
                                <group string="Tiempos del Proceso">
                                    <field name="fecha_solicitud"/>
                                    <field name="fecha_programada"/>
                                    <field name="fecha_inicio_real"
                                           readonly="1"
                                           invisible="not fecha_inicio_real"/>
                                    <field name="fecha_resolucion"
                                           invisible="not fecha_resolucion"/>
                                    <field name="dias_resolucion"
                                           readonly="1"/>
                                </group>
                            </group>
                        </page>

                        <!-- ============================================
                             TAB 3: COSTOS Y APROBACIÓN
                        ============================================ -->
                        <page string="💰 Costos" name="tab_costos">
                            <group>
                                <group string="Montos">
                                    <field name="currency_id" invisible="1"/>
                                    <field name="costo_estimado"
                                           widget="monetary"/>
                                    <field name="costo_real"
                                           widget="monetary"
                                           invisible="estado not in ['resuelto','cerrado']"/>
                                    <field name="diferencia_costo"
                                           widget="monetary"
                                           readonly="1"
                                           invisible="estado not in ['resuelto','cerrado']"/>
                                    <field name="pagado_por"/>
                                </group>
                                <group string="Aprobación del Propietario">
                                    <field name="requiere_aprobacion"
                                           readonly="1"
                                           widget="boolean_toggle"/>
                                    <field name="aprobado_por_propietario"
                                           widget="boolean_toggle"
                                           invisible="not requiere_aprobacion"/>
                                    <field name="fecha_aprobacion"
                                           invisible="not aprobado_por_propietario"/>
                                </group>
                            </group>
                        </page>

                        <!-- ============================================
                             TAB 4: DESCRIPCIÓN Y EVIDENCIA
                        ============================================ -->
                        <page string="📝 Descripción" name="tab_descripcion">
                            <group string="Problema Reportado">
                                <field name="descripcion_problema"
                                       placeholder="Ubicación exacta, síntomas, cuándo comenzó, impacto actual..."
                                       nolabel="1"/>
                            </group>
                            <group string="Trabajo Realizado"
                                   invisible="estado not in ['resuelto','cerrado','en_proceso']">
                                <field name="descripcion_trabajo"
                                       placeholder="Trabajo ejecutado, materiales utilizados, solución aplicada..."
                                       nolabel="1"/>
                            </group>
                            <group string="Evidencia Fotográfica">
                                <field name="tiene_evidencia_fotos"
                                       widget="boolean_toggle"/>
                                <div class="text-muted small"
                                     invisible="tiene_evidencia_fotos">
                                    <i class="fa fa-info-circle me-1" title="Info"/>
                                    Adjunta fotos del antes/después
                                    directamente en el Chatter como
                                    archivos adjuntos al mensaje.
                                </div>
                            </group>
                            <group string="Notas Internas">
                                <field name="notas_internas"
                                       placeholder="Observaciones privadas: negociaciones con proveedor, acuerdos con propietario..."
                                       nolabel="1"/>
                            </group>
                        </page>

                    </notebook>
                </sheet>

                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>

            </form>
        </field>
    </record>

    <!-- ================================================
         VISTA KANBAN — MANTENIMIENTO
         Agrupado por estado — vista de tablero del asesor
    ================================================ -->
    <record id="view_re_mantenimiento_kanban" model="ir.ui.view">
        <field name="name">re.mantenimiento.kanban</field>
        <field name="model">re.mantenimiento</field>
        <field name="arch" type="xml">
            <kanban default_group_by="estado"
                    quick_create="true"
                    class="o_kanban_small_column"
                    sample="1">

                <field name="name"/>
                <field name="estado"/>
                <field name="prioridad"/>
                <field name="categoria"/>
                <field name="tipo_ejecutor"/>
                <field name="propiedad_id"/>
                <field name="ticket_ref"/>
                <field name="proveedor_id"/>
                <field name="proveedor_nombre"/>
                <field name="costo_estimado"/>
                <field name="costo_real"/>
                <field name="requiere_aprobacion"/>
                <field name="aprobado_por_propietario"/>
                <field name="fecha_programada"/>
                <field name="dias_resolucion"/>
                <field name="origen_solicitud"/>
                <field name="currency_id"/>
                <field name="asesor_id"/>
                <field name="color"/>

                <templates>
                    <t t-name="kanban-box">
                        <div t-attf-class="oe_kanban_color_#{kanban_getcolor(record.color.raw_value)}
                                           oe_kanban_global_click shadow-sm border-rounded mb-2
                                           #{record.prioridad.raw_value == 'urgente' ?
                                             'border border-danger' :
                                             record.prioridad.raw_value == 'alta' ?
                                             'border border-warning' : ''}">

                            <!-- Ribbon: prioridad urgente -->
                            <div class="ribbon ribbon-top-right"
                                 t-if="record.prioridad.raw_value == 'urgente'">
                                <span class="text-bg-danger">URGENTE</span>
                            </div>

                            <!-- Ribbon: ticket de inquilino -->
                            <div class="ribbon ribbon-top-right"
                                 t-if="record.origen_solicitud.raw_value == 'inquilino'
                                       and record.prioridad.raw_value != 'urgente'">
                                <span class="text-bg-info">TICKET</span>
                            </div>

                            <div class="oe_kanban_details p-2">

                                <!-- Ticket ref + categoría -->
                                <div class="d-flex gap-1 mb-1">
                                    <span class="badge rounded-pill text-bg-secondary"
                                          style="font-size: 0.62rem;">
                                        <t t-esc="record.ticket_ref.value or 'MANT'"/>
                                    </span>
                                    <span class="badge rounded-pill text-bg-light"
                                          style="font-size: 0.62rem; border: 1px solid #dee2e6;">
                                        <t t-esc="record.categoria.value or '—'"/>
                                    </span>
                                </div>

                                <!-- Nombre -->
                                <strong class="o_kanban_record_title"
                                        style="font-size: 0.82rem;">
                                    <field name="name"/>
                                </strong>

                                <!-- Propiedad -->
                                <div class="text-muted small mt-1">
                                    <i class="fa fa-home me-1" title="Propiedad"/>
                                    <field name="propiedad_id"/>
                                </div>

                                <!-- Ejecutor -->
                                <div class="small mt-1">
                                    <t t-if="record.tipo_ejecutor.raw_value == 'asesor'">
                                        <i class="fa fa-user me-1" title="Asesor"/>
                                        <span class="text-muted">Asesor directo</span>
                                    </t>
                                    <t t-else="">
                                        <i class="fa fa-wrench me-1" title="Proveedor"/>
                                        <t t-if="record.proveedor_id.value">
                                            <field name="proveedor_id"/>
                                        </t>
                                        <t t-elif="record.proveedor_nombre.value">
                                            <t t-esc="record.proveedor_nombre.value"/>
                                        </t>
                                        <t t-else="">
                                            <span class="text-muted fst-italic">
                                                Sin asignar
                                            </span>
                                        </t>
                                    </t>
                                </div>

                                <!-- Costo -->
                                <div class="mt-1 small"
                                     t-if="record.costo_estimado.raw_value > 0">
                                    <i class="fa fa-usd me-1" title="Costo"/>
                                    <field name="costo_estimado" widget="monetary"/>
                                    <t t-if="record.requiere_aprobacion.raw_value
                                             and not record.aprobado_por_propietario.raw_value">
                                        <span class="text-warning ms-1">
                                            ⚠️ Sin aprobar
                                        </span>
                                    </t>
                                </div>

                                <!-- Días en proceso -->
                                <div class="mt-1 small text-muted"
                                     t-if="record.dias_resolucion.raw_value > 0">
                                    <i class="fa fa-clock-o me-1" title="Días"/>
                                    <t t-esc="record.dias_resolucion.raw_value"/> días
                                </div>

                                <!-- Footer -->
                                <div class="o_kanban_record_bottom mt-2">
                                    <div class="oe_kanban_bottom_left">
                                        <span t-attf-class="badge rounded-pill
                                            #{'text-bg-danger' if record.prioridad.raw_value == 'urgente'
                                              else 'text-bg-warning text-dark' if record.prioridad.raw_value == 'alta'
                                              else 'text-bg-secondary'}"
                                              style="font-size: 0.6rem;">
                                            <t t-esc="record.prioridad.value"/>
                                        </span>
                                    </div>
                                    <div class="oe_kanban_bottom_right">
                                        <field name="asesor_id"
                                               widget="many2one_avatar_user"/>
                                    </div>
                                </div>

                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- ================================================
         VISTA TREE — MANTENIMIENTO
    ================================================ -->
    <record id="view_re_mantenimiento_tree" model="ir.ui.view">
        <field name="name">re.mantenimiento.tree</field>
        <field name="model">re.mantenimiento</field>
        <field name="arch" type="xml">
            <tree sample="1"
                  decoration-danger="prioridad == 'urgente' and estado not in ['resuelto','cerrado','cancelado']"
                  decoration-warning="prioridad == 'alta' and estado not in ['resuelto','cerrado','cancelado']"
                  decoration-success="estado == 'cerrado'"
                  decoration-muted="estado == 'cancelado'">
                <field name="ticket_ref"/>
                <field name="name"/>
                <field name="propiedad_id"/>
                <field name="categoria"/>
                <field name="prioridad"
                       widget="badge"
                       decoration-danger="prioridad == 'urgente'"
                       decoration-warning="prioridad == 'alta'"
                       decoration-info="prioridad in ['normal','baja']"/>
                <field name="tipo_ejecutor"/>
                <field name="proveedor_id" optional="show"/>
                <field name="fecha_solicitud"/>
                <field name="fecha_programada" optional="show"/>
                <field name="dias_resolucion"/>
                <field name="costo_estimado"
                       widget="monetary"
                       optional="show"/>
                <field name="costo_real"
                       widget="monetary"
                       optional="show"/>
                <field name="requiere_aprobacion"
                       widget="boolean_toggle"
                       readonly="1"
                       optional="show"/>
                <field name="origen_solicitud" optional="show"/>
                <field name="asesor_id"
                       widget="many2one_avatar_user"/>
                <field name="estado"
                       widget="badge"
                       decoration-info="estado in ['solicitado', 'evaluando']"
                       decoration-warning="estado == 'aprobado'"
                       decoration-primary="estado == 'en_proceso'"
                       decoration-success="estado in ['resuelto','cerrado']"
                       decoration-danger="estado == 'cancelado'"/>
                <field name="currency_id" column_invisible="True"/>
            </tree>
        </field>
    </record>

    <!-- ================================================
         VISTA SEARCH — MANTENIMIENTO
    ================================================ -->
    <record id="view_re_mantenimiento_search" model="ir.ui.view">
        <field name="name">re.mantenimiento.search</field>
        <field name="model">re.mantenimiento</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="ticket_ref"/>
                <field name="propiedad_id"/>
                <field name="proveedor_id"/>
                <field name="categoria"/>
                <field name="asesor_id"/>
                <!-- Filtros de prioridad -->
                <filter string="🚨 Urgentes"
                        name="urgentes"
                        domain="[('prioridad', '=', 'urgente'),
                                 ('estado', 'not in', ['resuelto','cerrado','cancelado'])]"/>
                <filter string="🔴 Prioridad Alta"
                        name="alta"
                        domain="[('prioridad', '=', 'alta'),
                                 ('estado', 'not in', ['resuelto','cerrado','cancelado'])]"/>
                <separator/>
                <!-- Filtros de estado -->
                <filter string="📋 Solicitados"
                        name="solicitados"
                        domain="[('estado', '=', 'solicitado')]"/>
                <filter string="🔍 En Evaluación"
                        name="evaluando"
                        domain="[('estado', '=', 'evaluando')]"/>
                <filter string="🔄 En Proceso"
                        name="en_proceso"
                        domain="[('estado', '=', 'en_proceso')]"/>
                <filter string="🏁 Resueltos"
                        name="resueltos"
                        domain="[('estado', '=', 'resuelto')]"/>
                <filter string="📦 Cerrados"
                        name="cerrados"
                        domain="[('estado', '=', 'cerrado')]"/>
                <!-- Filtro de activos (todos los no cerrados/cancelados) -->
                <filter string="Activos"
                        name="activos"
                        domain="[('estado', 'not in', ['cerrado','cancelado'])]"/>
                <separator/>
                <!-- Filtros especiales -->
                <filter string="⚠️ Requieren Aprobación"
                        name="sin_aprobar"
                        domain="[('requiere_aprobacion', '=', True),
                                 ('aprobado_por_propietario', '=', False)]"/>
                <filter string="🧑 Tickets de Inquilinos"
                        name="tickets_inquilino"
                        domain="[('origen_solicitud', '=', 'inquilino')]"/>
                <filter string="🔧 Proveedor Externo"
                        name="proveedor_externo"
                        domain="[('tipo_ejecutor', '=', 'proveedor_externo')]"/>
                <separator/>
                <filter string="Mis Mantenimientos"
                        name="mis_mantenimientos"
                        domain="[('asesor_id', '=', uid)]"/>
                <separator/>
                <group expand="0" string="Agrupar por...">
                    <filter string="Estado"
                            name="group_estado"
                            context="{'group_by': 'estado'}"/>
                    <filter string="Prioridad"
                            name="group_prioridad"
                            context="{'group_by': 'prioridad'}"/>
                    <filter string="Categoría"
                            name="group_categoria"
                            context="{'group_by': 'categoria'}"/>
                    <filter string="Propiedad"
                            name="group_propiedad"
                            context="{'group_by': 'propiedad_id'}"/>
                    <filter string="Tipo de Ejecutor"
                            name="group_ejecutor"
                            context="{'group_by': 'tipo_ejecutor'}"/>
                    <filter string="Origen"
                            name="group_origen"
                            context="{'group_by': 'origen_solicitud'}"/>
                    <filter string="Pagado por"
                            name="group_pagador"
                            context="{'group_by': 'pagado_por'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- ================================================
         MENÚ — MANTENIMIENTO
    ================================================ -->
    <menuitem id="menu_re_mantenimiento"
              name="Mantenimiento"
              parent="menu_re_root"
              action="action_re_mantenimiento"
              sequence="50"/>

</odoo>
