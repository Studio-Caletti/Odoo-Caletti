<?xml version="1.0" encoding="utf-8"?>
<!-- CALETTI STUDIO - Core V2: Infraestructura de Reporteo PDF y Auditoría de Tareas -->
<odoo>
    <!-- ACCIÓN DE REPORTE: Define el disparador y el vínculo del modelo con el motor de renderizado QWeb PDF. -->
    <record id="action_report_tarea" model="ir.actions.report">
        <field name="name">Imprimir Tarea Caletti</field>
        <field name="model">tablero.tarea</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">tablero_kanban_caletti.report_tarea_template</field>
        <field name="binding_model_id" ref="model_tablero_tarea"/> <field name="binding_type">report</field>
    </record>
    <!-- VINCULACIÓN: Registra el botón de impresión directamente en el menú "Acción" del formulario de tareas. -->
    <template id="report_tarea_template">
    <t t-call="web.html_container">
    <!-- TEMPLATE MAESTRO: Estructura base del reporte que procesa la colección de registros (docs). -->
        <t t-foreach="docs" t-as="doc">
            <t t-call="web.external_layout">
                <div class="page">
    <!-- BRANDING DINÁMICO: Inyección de CSS para replicar la paleta de colores del Kanban en el documento impreso. -->
                    <style>
                        .color-bar { width: 10px; height: 50px; display: inline-block; margin-right: 15px; vertical-align: middle; }
                        .color-0 { background-color: #714B67; } /* Color por defecto (Púrpura Odoo) */
                        .color-1 { background-color: #F06050; } .color-2 { background-color: #F4A460; }
                        .color-3 { background-color: #F7CD1F; } .color-4 { background-color: #6CC1ED; }
                        .color-5 { background-color: #814968; } .color-6 { background-color: #EB7E7F; }
                        .color-7 { background-color: #2C8397; } .color-8 { background-color: #475577; }
                        .color-9 { background-color: #D6145F; } .color-10 { background-color: #30C381; }
                    </style>
    <!-- VISUAL IDENTIFIER: Renderizado de la barra de color seleccionada por el usuario para coherencia visual 360°. -->
                    <div class="mt-4">
                        <div t-attf-class="color-bar color-#{doc.color or 0}"></div>
                        <h2 style="display: inline-block; vertical-align: middle;">
                            Informe de Tarea: <span t-field="doc.name"/>
                        </h2>
                    </div>
                    
    <!-- ESTRUCTURA DE CABECERA: Organización de metadatos críticos para la identificación rápida de la tarea. -->
                    <hr/>                    
                    <div class="row mt-4">
                        <div class="col-6">
                            <strong>Responsable:</strong> <p t-field="doc.user_id.name"/>
                        </div>
    <!-- LÓGICA SEMÁNTICA: Badge de estado dinámico que traduce el workflow técnico a etiquetas visuales legibles. -->
                        <div class="col-6 text-end">
                            <strong>Estado:</strong> 
                                <p>
                                <span class="badge rounded-pill bg-info text-white" t-if="doc.state == 'nuevo'">Nuevo</span>
                                <span class="badge rounded-pill bg-warning text-dark" t-if="doc.state == 'proceso'">En Proceso</span>
                                <span class="badge rounded-pill bg-success text-white" t-if="doc.state == 'hecho'">Finalizado</span>
                                </p>
                            </div>
                        </div>
                    </div>
                </t>
            </t>
        </t>
    </template>
</odoo>
