<!-- DATA del Vertical Creativo: Helpdesk Caletti -->
<odoo>
    <data noupdate="0">
        
        <!-- SECUENCIA PARA REFERENCIAS DE TICKETS -->
        <record id="seq_tablero_ticket" model="ir.sequence">
            <field name="name">Ticket Referencia</field>
            <field name="code">tablero.ticket</field>
            <field name="prefix">TK-</field>
            <field name="padding">5</field>
            <field name="number_increment">1</field>
            <field name="number_next">1</field>
            <field name="implementation">standard</field>
        </record>

        <!-- ALIAS YA EXISTE - NO CREAR -->

        <!-- PLANTILLA DE CORREO: Confirmación de Ticket Recibido -->
        <record id="email_template_ticket_confirmacion" model="mail.template">
            <field name="name">Helpdesk: Confirmación de Ticket</field>
            <field name="model_id" ref="tablero_kanban_caletti.model_tablero_tarea"/>
            <field name="subject">✅ Ticket {{ object.ticket_ref or 'N/A' }} - {{ object.name or 'Sin asunto' }}</field>
            <field name="email_from">notifications@caletti.com.mx</field>
            <field name="email_to">{{ object.partner_id.email or object.ticket_email }}</field>
            <field name="reply_to">soporte@caletti.com.mx</field>
            <field name="auto_delete" eval="False"/>
            <field name="body_html" type="html">
<div style="margin: 0px; padding: 0px; font-family: 'Helvetica', sans-serif; background-color: #f4f4f4;">
    <table width="100%" style="background-color: #f4f4f4; padding: 20px;">
        <tr>
            <td align="center">
                <table width="600" style="background-color: #ffffff; border-radius: 8px; margin-top: 20px; border-collapse: separate; box-shadow: 0 2px 5px rgba(0,0,0,0.1);">
                    <tr>
                        <td style="padding: 40px;">
                            <span><img src="https://caletti.com.mx/odoo17/caletti_odoo.png" 
                                     style="padding: 0px; margin: 0px; height: auto; width: 180px;" 
                                     alt="Caletti Studio"/></span>
                            <h2 style="color: #875A7B; margin-top: 0; font-size: 24px;">
                                ✅ Hemos recibido tu solicitud
                            </h2>
                            <p style="font-size: 16px; color: #333;">
                                Hola <strong><t t-out="object.partner_id.name or 'Cliente'"/></strong>,
                            </p>
                            <p style="font-size: 15px; color: #555; line-height: 1.5;">
                                Gracias por contactarnos. Hemos registrado tu ticket con la siguiente información:
                            </p>
                            
                            <div style="margin: 25px 0; padding: 20px; border-left: 4px solid #875A7B; background-color: #f9f9f9;">
                                <p style="margin: 8px 0; font-size: 14px;">
                                    <span style="font-size: 14px; color: #777; text-transform: uppercase;">Número de Ticket:</span><br/>
                                    <strong style="font-size: 18px; color: #875A7B;"><t t-out="object.ticket_ref or 'Pendiente'"/></strong>
                                </p>
                                <p style="margin: 8px 0; font-size: 14px;">
                                    <span style="font-size: 14px; color: #777;">Asunto:</span><br/>
                                    <strong><t t-out="object.name or 'Sin asunto'"/></strong>
                                </p>
                                <p style="margin: 8px 0; font-size: 14px;">
                                    <span style="font-size: 14px; color: #777;">Tipo:</span><br/>
                                    <strong>
                                        <t t-if="object.tipo_ticket == 'soporte'">Soporte Técnico</t>
                                        <t t-elif="object.tipo_ticket == 'facturacion'">Facturación</t>
                                        <t t-elif="object.tipo_ticket == 'mejora'">Solicitud de Mejora</t>
                                        <t t-elif="object.tipo_ticket == 'error'">Reporte de Error</t>
                                        <t t-else="">Consulta General</t>
                                    </strong>
                                </p>
                                <p style="margin: 8px 0; font-size: 14px;">
                                    <span style="font-size: 14px; color: #777;">Prioridad:</span><br/>
                                    <strong>
                                        <t t-if="object.prioridad_ticket == '3'">🔴 Crítica</t>
                                        <t t-elif="object.prioridad_ticket == '2'">🟠 Alta</t>
                                        <t t-elif="object.prioridad_ticket == '1'">🟡 Media</t>
                                        <t t-else="">🟢 Baja</t>
                                    </strong>
                                </p>
                                <p style="margin: 8px 0; font-size: 14px;">
                                    <span style="font-size: 14px; color: #777;">Estado:</span><br/>
                                    <strong>
                                        <t t-if="object.state == 'hecho'">✅ Finalizado</t>
                                        <t t-elif="object.state == 'proceso'">🔄 En Proceso</t>
                                        <t t-else="">🆕 Nuevo</t>
                                    </strong>
                                </p>
                                <t t-if="object.date_deadline">
                                    <p style="margin: 8px 0; font-size: 14px;">
                                        <span style="font-size: 14px; color: #777;">Fecha de vencimiento:</span><br/>
                                        <strong><t t-out="object.date_deadline"/></strong>
                                    </p>
                                </t>
                            </div>
                            
                            <p style="font-size: 14px; color: #555;">
                                Nuestro equipo revisará tu solicitud y te responderemos lo antes posible.
                            </p>
                            
                            <p style="font-size: 14px; color: #555;">
                                Puedes ver el estado de tu ticket en cualquier momento desde tu portal de cliente.
                            </p>
                        </td>
                    </tr>
                    <tr>
                        <td style="padding: 20px; background-color: #f9f9f9; text-align: center; border-bottom-left-radius: 8px; border-bottom-right-radius: 8px;">
                            <p style="font-size: 13px; color: #666; margin: 5px 0;">
                                Saludos,<br/>
                                <strong>Equipo de Soporte - Caletti Studio</strong>
                            </p>
                            <h5><strong>MÉXICO - BUENOS AIRES - ROMA</strong></h5>
                            <p style="font-size: 11px; color: #aaa; margin: 10px 0 0 0;">
                                Este es un mensaje automático del sistema de tickets
                            </p>
                        </td>
                    </tr>
                </table>
            </td>
        </tr>
    </table>
</div>
            </field>
        </record>

    </data>
</odoo>